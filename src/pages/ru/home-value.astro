---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import ContactBand from '../../components/ContactBand.astro';
import img from '../../assets/tamila-aspen-on-phone.jpg';
import { site } from '../../data/site.js';

const steps = [
  ['Отправьте адрес', 'Имя, телефон и адрес дома. Можно добавить, что важно: новая крыша, отделанный подвал, что требует ремонта.'],
  ['Тамила смотрит реальные продажи', 'Она берёт недавние продажи и активные объявления рядом с вами из MLS, той же базы, по которой агенты ставят цену, и сравнивает их с вашим домом.'],
  ['Вы получаете цену и расчёт', 'Реальный диапазон цены и примерную сумму, которая останется вам после комиссий, title, налога на недвижимость и погашения ипотеки. Без давления и обязательств.'],
];
const faq = [
  ['Оценка правда бесплатная?', 'Да. Это ничего не стоит и ни к чему не обязывает. Многие спрашивают за год до продажи, просто чтобы планировать.'],
  ['Чем это отличается от оценки на Zillow?', 'Онлайн-оценка — это компьютерная модель, она не видит ваш дом изнутри. Тамила сравнивает ваш дом с недавними продажами рядом из MLS и учитывает состояние, ремонт, участок и расположение — так, как на самом деле ставится цена.'],
  ['Нужно ли Тамиле приезжать?', 'Для первой оценки обычно нет: хватает фото или короткого звонка. Если вы готовитесь к продаже, осмотр дома даёт самую точную цифру.'],
  ['В каких районах работает Тамила?', 'Front Range от Loveland до Colorado Springs: Денвер, Аврора, Сентенниал, Литтлтон, Паркер, Хайлендс Ранч, Лейквуд, Торнтон, Брайтон и другие.'],
  ['Что такое net sheet?', 'Расчёт денег, которые вы получите на закрытии сделки: цена продажи минус комиссии, title insurance и closing fee, налог на недвижимость за этот год, сборы HOA и остаток ипотеки.'],
  ['Сколько стоит продать дом с Тамилой?', 'Если вы продаёте дом и покупаете следующий вместе с ней, её комиссия за продажу 1% вместо обычных до 3%. Если только продаёте — стандартная ставка, до 3%. Агент покупателя оплачивается отдельно, это обсуждается.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'ru', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base lang="ru" title="Сколько стоит мой дом? Бесплатная оценка в Денвере" description="Бесплатная оценка дома в Денвере и Колорадо по реальным продажам из MLS, а не по Zillow. Плюс расчёт, сколько останется вам. По-русски, без обязательств." schema={schema} alternates={{ en: '/home-value', ru: '/ru/home-value', uk: '/uk/home-value' }}>
  <PageHero
    ru
    eyebrow="Бесплатно · Без обязательств"
    title="Сколько стоит ваш дом?"
    lead="Узнайте реальную цену от местного агента — по недавним продажам рядом с вами, а не по компьютерной оценке. Тамила также покажет, сколько останется вам после всех расходов на продажу. На русском языке."
    image={img}
    imageAlt="Тамила Аспен, агент по недвижимости в Денвере"
    cta2={['#contact', 'Получить оценку']}
  />

  <section class="section mist">
    <div class="wrap">
      <h2 class="center">Как это работает</h2>
      <ol class="steps">
        {steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
      <p class="center btnrow"><a class="pill" href="#contact">Отправить адрес</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Почему онлайн-оценки часто ошибаются</h2>
      <p>Онлайн-оценка не знает, что вы сделали новую кухню, отделали подвал или что дом стоит у оживлённой дороги. Два дома на одной улице могут продаться с разницей в десятки тысяч долларов. Цена по сравнимым продажам, скорректированная человеком, который знает район, — это то, на что реально смотрят покупатели и оценщики банка.</p>
      <h2>Продаёте и покупаете?</h2>
      <p>Когда вы продаёте дом и покупаете следующий с Тамилой, её комиссия за продажу — 1% вместо обычных до 3%. Попросите показать в расчёте оба варианта.</p>
      <div class="btns"><a class="pill pill--line" href="/ru">Все услуги на русском</a><a class="pill pill--line" href="/cost-to-sell-a-house-in-colorado">Калькулятор продажи (EN)</a></div>
    </div>
  </section>

  <Faq items={faq} title="Вопросы об оценке" />
  <ContactBand ru title="Бесплатная оценка вашего дома" lead="Оставьте адрес. Тамила перезвонит, уточнит детали и пришлёт диапазон цены и расчёт. По-русски или по-украински." goal="Бесплатная оценка дома" address={true} subject="Оценка дома (RU)" send="Получить оценку" />
</Base>

<style>
  .steps { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: s; }
  .steps li { counter-increment: s; background: var(--white); border-radius: 20px; padding: 26px; display: flex; flex-direction: column; gap: 8px; }
  .steps li::before { content: counter(s); width: 38px; height: 38px; border-radius: 50%; background: var(--green); color: var(--white); display: grid; place-items: center; font-weight: 800; }
  .steps p { font-weight: 400; font-size: 1rem; }
  .btnrow { margin-top: 32px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }
</style>
