---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import img from '../../assets/tamila-aspen-loan-officer-laptop.jpg';
import { site } from '../../data/site.js';

const go = '/go/self-employed';
const who = [
  ['Владельцы бизнеса', 'Подрядчики, салоны, рестораны, траковые и клининговые компании. Списания уменьшают налогооблагаемый доход, и по налоговой декларации кажется, что вы зарабатываете меньше, чем на самом деле.'],
  ['1099 и гиг-работа', 'Независимые подрядчики, агенты по недвижимости, медсёстры по контракту, водители такси и доставки. Доход, который меняется от месяца к месяцу, трудно вписать в обычный кредит.'],
  ['Смешанный или новый доход', 'Зарплата плюс свой бизнес, доход от комиссий или бизнес, который быстро вырос за последние год-два.'],
  ['Инвесторы', 'У вас есть сдаваемая недвижимость или вы хотите купить первую. Некоторые кредиты одобряют по аренде объекта, а не по вашему личному доходу.'],
];
const programs = [
  ['Bank statement loan', 'Доход считают по поступлениям на личный или бизнес-счёт за 12 или 24 месяца вместо налоговых деклараций.'],
  ['1099 loan', 'Доход считают по формам 1099. Подходит, если у вас стабильные клиенты, но большие списания.'],
  ['P&L loan', 'Доход считают по отчёту о прибылях и убытках бизнеса, который обычно готовит или подтверждает налоговый специалист.'],
  ['Asset depletion', 'Сбережения и инвестиции пересчитывают в ежемесячный доход. Помогает тем, кто продал бизнес или имеет большие накопления.'],
  ['DSCR для инвесторов', 'Кредит одобряют по ожидаемой аренде относительно платежа. Без документов о личном доходе. Можно оформить на LLC.'],
  ['Обычный кредит, если подходит', 'Если в налоговых декларациях уже достаточно дохода, conventional или FHA обычно дешевле. Тамила проверяет это первым делом.'],
];
const ready = [
  'Сколько времени вы работаете на себя и какой у вас бизнес',
  'Выписки по счетам за последние 12–24 месяца (личные, бизнес или оба)',
  'Бизнес-лицензия, письмо от CPA или другое подтверждение, что бизнес работает, если есть',
  'Формы 1099 или отчёт P&L, если подходят эти программы',
  'Примерный ценовой диапазон и сколько у вас есть на первый взнос',
];
const faq = [
  ['Можно ли получить ипотеку, если я самозанятый в Колорадо?', 'Да. Если в налоговых декларациях достаточно дохода, подойдёт обычный conventional или FHA. Если из-за списаний доход выглядит слишком маленьким, программы Non-QM — bank statement, 1099 или P&L — считают доход по-другому.'],
  ['За сколько месяцев нужны выписки?', 'Обычно за 12 или 24 месяца, личные или бизнес, в зависимости от программы и вашей ситуации.'],
  ['Сколько нужно работать на себя?', 'Обычно около двух лет в той же сфере. Бывают исключения, например если до своего бизнеса вы работали в той же области по найму. Расскажите Тамиле свою ситуацию, она проверит.'],
  ['Bank statement loan дороже?', 'Часто да. Кредиты Non-QM обычно имеют более высокую ставку и могут требовать большего первого взноса, чем conventional. Если обычный кредит возможен, Тамила покажет оба варианта рядом.'],
  ['Испортит ли проверка мой кредит?', 'Разговор — нет. Чтобы увидеть варианты, достаточно мягкой проверки (soft pull), которая не влияет на рейтинг.'],
  ['Форма Barrett на английском. Что делать?', 'Можно просто позвонить или написать Тамиле на русском — она всё заполнит вместе с вами.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'ru', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base lang="ru" title="Ипотека для самозанятых в Колорадо: по выпискам банка" description="Работаете на себя в Денвере? Bank statement, 1099 и P&L кредиты смотрят на реальный доход, а не только на налоговую декларацию. По-русски, Тамила Аспен." schema={schema} alternates={{ en: '/self-employed-mortgage-colorado', ru: '/ru/self-employed-mortgage-colorado', uk: '/uk/self-employed-mortgage-colorado' }}>
  <PageHero
    ru
    eyebrow={`Ипотека для самозанятых · NMLS #${site.nmls}`}
    title="Работаете на себя? Налоговая декларация — это не вся история"
    lead="Списания экономят налоги, но делают доход слишком маленьким для обычной ипотеки. Bank statement и 1099 кредиты смотрят на то, что реально приходит на ваши счета. Тамила 23 года работала в финансах и бухгалтерии и читает доход бизнеса так же, как андеррайтер."
    image={img}
    imageAlt="Тамила Аспен, ипотечный специалист, за ноутбуком"
    pos="50% 30%"
    cta2={[go, 'Проверить, подхожу ли я']}
  />

  <section class="section mist">
    <div class="wrap">
      <div class="narrow center stack"><h2>Для кого эти кредиты</h2></div>
      <div class="cards cards--2">
        {who.map(([h, p]) => <article class="card"><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="narrow center stack">
        <h2>Варианты кредитов для самозанятых</h2>
        <p class="lead">Тамила — ипотечный брокер с доступом примерно к 200 оптовым кредиторам. Она сравнивает программы и выбирает ту, что подходит под то, как вы зарабатываете.</p>
      </div>
      <div class="cards">
        {programs.map(([h, p]) => <article class="card"><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>Что подготовить</h2>
      <ul>{ready.map((r) => <li>{r}</li>)}</ul>
      <p>Всё сразу не нужно. Нескольких деталей достаточно, чтобы Тамила сказала, какие программы стоит рассматривать.</p>
      <h2>Bank statement или обычный кредит?</h2>
      <p>Conventional использует доход из налоговых деклараций и обычно имеет более низкую ставку, поэтому его проверяют первым. Bank statement loan смотрит на поступления на счёт, что часто показывает больший доход у владельцев бизнеса с большими списаниями, но обычно стоит дороже. Правильный выбор зависит от ваших цифр, и Тамила показывает оба варианта рядом, когда это возможно.</p>
    </div>
  </section>

  <section class="section se-cta">
    <div class="wrap narrow center stack">
      <h2>Узнайте свои варианты</h2>
      <p class="lead">Ответьте на несколько вопросов о бизнесе на защищённой странице Тамилы в Barrett Financial Group (на английском). Без проверки кредита на старте. Или просто позвоните или напишите ей по-русски.</p>
      <div class="btns">
        <a class="pill" href={`tel:${site.phoneHref}`}>Позвонить {site.phone}</a>
        <a class="pill pill--line" href={`sms:${site.phoneHref}`}>Написать Тамиле</a>
        <a class="pill pill--line" href={go}>Форма Barrett (EN)</a>
      </div>
      <p class="small">{site.lenderDisclaimer} <a href={`https://www.nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/${site.lenderNmls}`} target="_blank" rel="noopener">NMLS Consumer Access</a>. Ставки, условия и программы могут меняться и зависят от андеррайтинга.</p>
    </div>
  </section>

  <Faq items={faq} title="Вопросы об ипотеке для самозанятых" />

  <section class="section">
    <div class="wrap narrow center stack">
      <p>Ещё: <a href="/ru">все услуги на русском</a> · <a href="/ru/home-value">бесплатная оценка дома</a> · <a href="/self-employed-mortgage-colorado">English version</a></p>
    </div>
  </section>
</Base>

<style>
  .small { font-size: .8rem; opacity: .8; }
  .se-cta { background: var(--sage); }
  .cards--2 { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 620px) { .cards--2 { grid-template-columns: 1fr; } }
</style>
