---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Accessibility Statement | Tamila Aspen" description="Accessibility statement for denver-real-estates.com, the website of Tamila Aspen, Denver real estate agent and mortgage loan officer.">
  <section class="section"><div class="wrap prose">
    <h1>Accessibility Statement</h1>
    <p>We want everyone to be able to use this website. It is built to follow WCAG 2.2 AA guidelines: readable contrast, keyboard navigation, descriptive image text and a layout that works on phones.</p>
    <p>If anything on this site is hard to use, call {site.phone} or email {site.email}. We will help you directly and fix the problem.</p>
  </div></section>
</Base>
