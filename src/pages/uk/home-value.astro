---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import ContactBand from '../../components/ContactBand.astro';
import img from '../../assets/tamila-aspen-on-phone.jpg';
import { site } from '../../data/site.js';

const steps = [
  ['Надішліть адресу', 'Ім’я, телефон і адресу будинку. Можна додати, що важливо: новий дах, оздоблений підвал, що потребує ремонту.'],
  ['Таміла дивиться реальні продажі', 'Вона бере нещодавні продажі та активні оголошення поруч із вами з MLS, тієї ж бази, за якою агенти встановлюють ціну, і порівнює їх із вашим будинком.'],
  ['Ви отримуєте ціну та розрахунок', 'Реальний діапазон ціни та приблизну суму, яка залишиться вам після комісій, title, податку на нерухомість і погашення іпотеки. Без тиску та зобов’язань.'],
];
const faq = [
  ['Оцінка справді безкоштовна?', 'Так. Це нічого не коштує і ні до чого не зобов’язує. Багато хто питає за рік до продажу, просто щоб планувати.'],
  ['Чим це відрізняється від оцінки на Zillow?', 'Онлайн-оцінка — це комп’ютерна модель, вона не бачить ваш будинок зсередини. Таміла порівнює ваш будинок із нещодавніми продажами поруч з MLS і враховує стан, ремонт, ділянку та розташування — так, як насправді встановлюється ціна.'],
  ['Чи потрібно Тамілі приїжджати?', 'Для першої оцінки зазвичай ні: достатньо фото або короткого дзвінка. Якщо ви готуєтеся до продажу, огляд будинку дає найточнішу цифру.'],
  ['У яких районах працює Таміла?', 'Front Range від Loveland до Colorado Springs: Денвер, Аврора, Сентенніал, Літтлтон, Паркер, Хайлендс Ранч, Лейквуд, Торнтон, Брайтон та інші.'],
  ['Що таке net sheet?', 'Розрахунок грошей, які ви отримаєте на закритті угоди: ціна продажу мінус комісії, title insurance і closing fee, податок на нерухомість за цей рік, збори HOA та залишок іпотеки.'],
  ['Скільки коштує продати будинок із Тамілою?', 'Якщо ви продаєте будинок і купуєте наступний разом із нею, її комісія за продаж 1% замість звичайних до 3%. Якщо тільки продаєте — стандартна ставка, до 3%. Агент покупця оплачується окремо, це обговорюється.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'uk', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base lang="uk" title="Скільки коштує мій будинок? Безкоштовна оцінка, Денвер" description="Безкоштовна оцінка будинку в Денвері та Колорадо за реальними продажами з MLS, а не за Zillow. Плюс розрахунок, скільки залишиться вам. Українською." schema={schema} alternates={{ en: '/home-value', ru: '/ru/home-value', uk: '/uk/home-value' }}>
  <PageHero
    uk
    eyebrow="Безкоштовно · Без зобов’язань"
    title="Скільки коштує ваш будинок?"
    lead="Дізнайтеся реальну ціну від місцевого агента — за нещодавніми продажами поруч із вами, а не за комп’ютерною оцінкою. Таміла також покаже, скільки залишиться вам після всіх витрат на продаж. Українською мовою."
    image={img}
    imageAlt="Таміла Аспен, агент з нерухомості в Денвері"
    cta2={['#contact', 'Отримати оцінку']}
  />

  <section class="section mist">
    <div class="wrap">
      <h2 class="center">Як це працює</h2>
      <ol class="steps">
        {steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
      <p class="center btnrow"><a class="pill" href="#contact">Надіслати адресу</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Чому онлайн-оцінки часто помиляються</h2>
      <p>Онлайн-оцінка не знає, що ви зробили нову кухню, оздобили підвал або що будинок стоїть біля жвавої дороги. Два будинки на одній вулиці можуть продатися з різницею в десятки тисяч доларів. Ціна за порівнянними продажами, скоригована людиною, яка знає район, — це те, на що реально дивляться покупці та оцінювачі банку.</p>
      <h2>Продаєте і купуєте?</h2>
      <p>Коли ви продаєте будинок і купуєте наступний із Тамілою, її комісія за продаж — 1% замість звичайних до 3%. Попросіть показати в розрахунку обидва варіанти.</p>
      <div class="btns"><a class="pill pill--line" href="/uk">Усі послуги українською</a><a class="pill pill--line" href="/cost-to-sell-a-house-in-colorado">Калькулятор продажу (EN)</a></div>
    </div>
  </section>

  <Faq items={faq} title="Питання про оцінку" />
  <ContactBand uk title="Безкоштовна оцінка вашого будинку" lead="Залиште адресу. Таміла передзвонить, уточнить деталі та надішле діапазон ціни й розрахунок. Українською або російською." goal="Безкоштовна оцінка будинку" address={true} subject="Оцінка будинку (UA)" send="Отримати оцінку" />
</Base>

<style>
  .steps { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: s; }
  .steps li { counter-increment: s; background: var(--white); border-radius: 20px; padding: 26px; display: flex; flex-direction: column; gap: 8px; }
  .steps li::before { content: counter(s); width: 38px; height: 38px; border-radius: 50%; background: var(--green); color: var(--white); display: grid; place-items: center; font-weight: 800; }
  .steps p { font-weight: 400; font-size: 1rem; }
  .btnrow { margin-top: 32px; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }
</style>
