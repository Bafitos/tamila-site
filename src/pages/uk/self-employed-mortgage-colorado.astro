---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import img from '../../assets/tamila-aspen-loan-officer-laptop.jpg';
import { site } from '../../data/site.js';

const go = '/go/self-employed';
const who = [
  ['Власники бізнесу', 'Підрядники, салони, ресторани, тракові та клінінгові компанії. Списання зменшують оподатковуваний дохід, і за податковою декларацією здається, що ви заробляєте менше, ніж насправді.'],
  ['1099 і гіг-робота', 'Незалежні підрядники, агенти з нерухомості, медсестри за контрактом, водії таксі та доставки. Дохід, що змінюється від місяця до місяця, важко вписати у звичайний кредит.'],
  ['Змішаний або новий дохід', 'Зарплата плюс власний бізнес, дохід від комісій або бізнес, що швидко виріс за останній рік-два.'],
  ['Інвестори', 'У вас є нерухомість в оренду або ви хочете купити першу. Деякі кредити схвалюють за орендою об’єкта, а не за вашим особистим доходом.'],
];
const programs = [
  ['Bank statement loan', 'Дохід рахують за надходженнями на особистий або бізнес-рахунок за 12 або 24 місяці замість податкових декларацій.'],
  ['1099 loan', 'Дохід рахують за формами 1099. Підходить, якщо у вас стабільні клієнти, але великі списання.'],
  ['P&L loan', 'Дохід рахують за звітом про прибутки та збитки бізнесу, який зазвичай готує або підтверджує податковий фахівець.'],
  ['Asset depletion', 'Заощадження та інвестиції перераховують у щомісячний дохід. Допомагає тим, хто продав бізнес або має великі накопичення.'],
  ['DSCR для інвесторів', 'Кредит схвалюють за очікуваною орендою відносно платежу. Без документів про особистий дохід. Можна оформити на LLC.'],
  ['Звичайний кредит, якщо підходить', 'Якщо в податкових деклараціях уже достатньо доходу, conventional або FHA зазвичай дешевші. Таміла перевіряє це насамперед.'],
];
const ready = [
  'Скільки часу ви працюєте на себе і який у вас бізнес',
  'Виписки з рахунків за останні 12–24 місяці (особисті, бізнес або обидва)',
  'Бізнес-ліцензія, лист від CPA або інше підтвердження, що бізнес працює, якщо є',
  'Форми 1099 або звіт P&L, якщо підходять ці програми',
  'Приблизний ціновий діапазон і скільки у вас є на перший внесок',
];
const faq = [
  ['Чи можна отримати іпотеку, якщо я самозайнятий у Колорадо?', 'Так. Якщо в податкових деклараціях достатньо доходу, підійде звичайний conventional або FHA. Якщо через списання дохід виглядає замалим, програми Non-QM — bank statement, 1099 або P&L — рахують дохід інакше.'],
  ['За скільки місяців потрібні виписки?', 'Зазвичай за 12 або 24 місяці, особисті або бізнес, залежно від програми та вашої ситуації.'],
  ['Скільки потрібно працювати на себе?', 'Зазвичай близько двох років у тій самій сфері. Бувають винятки, наприклад якщо до свого бізнесу ви працювали в тій самій галузі за наймом. Розкажіть Тамілі свою ситуацію, вона перевірить.'],
  ['Bank statement loan дорожчий?', 'Часто так. Кредити Non-QM зазвичай мають вищу ставку і можуть вимагати більшого першого внеску, ніж conventional. Якщо звичайний кредит можливий, Таміла покаже обидва варіанти поруч.'],
  ['Чи зіпсує перевірка мій кредит?', 'Розмова — ні. Щоб побачити варіанти, достатньо м’якої перевірки (soft pull), яка не впливає на рейтинг.'],
  ['Форма Barrett англійською. Що робити?', 'Можна просто зателефонувати або написати Тамілі українською — вона все заповнить разом із вами.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'uk', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base lang="uk" title="Іпотека для самозайнятих у Колорадо: за виписками банку" description="Працюєте на себе в Денвері? Bank statement, 1099 і P&L кредити дивляться на реальний дохід, а не лише на податкову декларацію. Українською, Таміла Аспен." schema={schema} alternates={{ en: '/self-employed-mortgage-colorado', ru: '/ru/self-employed-mortgage-colorado', uk: '/uk/self-employed-mortgage-colorado' }}>
  <PageHero
    uk
    eyebrow={`Іпотека для самозайнятих · NMLS #${site.nmls}`}
    title="Працюєте на себе? Податкова декларація — це не вся історія"
    lead="Списання економлять податки, але роблять дохід замалим для звичайної іпотеки. Bank statement і 1099 кредити дивляться на те, що реально надходить на ваші рахунки. Таміла 23 роки працювала у фінансах і бухгалтерії та читає дохід бізнесу так само, як андеррайтер."
    image={img}
    imageAlt="Таміла Аспен, іпотечний фахівець, за ноутбуком"
    pos="50% 30%"
    cta2={[go, 'Перевірити, чи підходжу я']}
  />

  <section class="section mist">
    <div class="wrap">
      <div class="narrow center stack"><h2>Для кого ці кредити</h2></div>
      <div class="cards cards--2">
        {who.map(([h, p]) => <article class="card"><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="narrow center stack">
        <h2>Варіанти кредитів для самозайнятих</h2>
        <p class="lead">Таміла — іпотечний брокер із доступом приблизно до 200 оптових кредиторів. Вона порівнює програми та обирає ту, що підходить під те, як ви заробляєте.</p>
      </div>
      <div class="cards">
        {programs.map(([h, p]) => <article class="card"><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>Що підготувати</h2>
      <ul>{ready.map((r) => <li>{r}</li>)}</ul>
      <p>Усе одразу не потрібно. Кількох деталей достатньо, щоб Таміла сказала, які програми варто розглядати.</p>
      <h2>Bank statement чи звичайний кредит?</h2>
      <p>Conventional використовує дохід із податкових декларацій і зазвичай має нижчу ставку, тому його перевіряють першим. Bank statement loan дивиться на надходження на рахунок, що часто показує більший дохід у власників бізнесу з великими списаннями, але зазвичай коштує дорожче. Правильний вибір залежить від ваших цифр, і Таміла показує обидва варіанти поруч, коли це можливо.</p>
    </div>
  </section>

  <section class="section se-cta">
    <div class="wrap narrow center stack">
      <h2>Дізнайтеся свої варіанти</h2>
      <p class="lead">Дайте відповідь на кілька запитань про бізнес на захищеній сторінці Таміли в Barrett Financial Group (англійською). Без перевірки кредиту на старті. Або просто зателефонуйте чи напишіть їй українською.</p>
      <div class="btns">
        <a class="pill" href={`tel:${site.phoneHref}`}>Зателефонувати {site.phone}</a>
        <a class="pill pill--line" href={`sms:${site.phoneHref}`}>Написати Тамілі</a>
        <a class="pill pill--line" href={go}>Форма Barrett (EN)</a>
      </div>
      <p class="small">{site.lenderDisclaimer} <a href={`https://www.nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/${site.lenderNmls}`} target="_blank" rel="noopener">NMLS Consumer Access</a>. Ставки, умови та програми можуть змінюватися і залежать від андеррайтингу.</p>
    </div>
  </section>

  <Faq items={faq} title="Питання про іпотеку для самозайнятих" />

  <section class="section">
    <div class="wrap narrow center stack">
      <p>Ще: <a href="/uk">усі послуги українською</a> · <a href="/uk/home-value">безкоштовна оцінка будинку</a> · <a href="/self-employed-mortgage-colorado">English version</a></p>
    </div>
  </section>
</Base>

<style>
  .small { font-size: .8rem; opacity: .8; }
  .se-cta { background: var(--sage); }
  .cards--2 { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 620px) { .cards--2 { grid-template-columns: 1fr; } }
</style>
