---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site.js';
import afford from '../data/afford.json';
import data from '../data/state-costs.json';

// Tax and insurance data: src/data/state-costs.json (verified from primary sources; refreshed by the twice-yearly scheduled task).
// Median sale prices: src/data/afford.json (Redfin), refreshed monthly by .github/workflows/redfin-monthly.yml; median household income: Census ACS (yearly).
const taxChecked = 'November 2026';
const states = data.states
  .map((r: any) => { const extra = (afford as any).priceExtra?.[r.s]; const home = (afford.price as Record<string, number>)[r.s] ?? extra?.price ?? null; const priceLabel = (afford.price as Record<string, number>)[r.s] ? null : extra?.label ?? null; const income = (afford.income as Record<string, number>)[r.s] ?? null; const homeHouse = ((afford as any).priceHouses as Record<string, number>)?.[r.s] ?? null; return { ...r, home, homeHouse, priceLabel, income, ratio: home && income ? Math.round(home / income * 100) / 100 : null }; })
  .sort((a: any, b: any) => a.s.localeCompare(b.s));
const co = states.find((r: any) => r.s === 'Colorado');
const others = states.filter((r: any) => r.s !== 'Colorado');
const by = (n: string) => states.find((r: any) => r.s === n);
const zMonth = new Date(afford.priceMonth + 'T12:00:00Z').toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const la = (afford as any).priceExtra?.Louisiana;
const laMonth = la ? new Date(la.month + 'T12:00:00Z').toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const ord = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
const listAnd = (a: string[]) => a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];
const round1k = (n: number) => '$' + (Math.round(n / 1000) * 1000).toLocaleString('en-US');
const priced = states.filter((r: any) => r.home);
const homeRank = [...priced].sort((a: any, b: any) => b.home - a.home).findIndex((r: any) => r.s === 'Colorado') + 1;
const ratioRank = [...priced].sort((a: any, b: any) => b.ratio - a.ratio).findIndex((r: any) => r.s === 'Colorado') + 1;
const usRatio = Math.round(priced.reduce((t: number, r: any) => t + r.ratio, 0) / priced.length * 100) / 100;
const noIncome = states.filter((r: any) => r.single.length === 0).map((r: any) => r.s);
const tx = by('Texas'), fl = by('Florida');
const popular = ['California', 'Texas', 'Florida', 'Illinois', 'New York', 'Arizona', 'Washington', 'Georgia'];

const faq = [
  ['Is Colorado a tax-friendly state to move to?', `It depends on where you are coming from. Colorado has a flat 4.40% income tax for 2026, and its property taxes are among the lowest in the country: about ${co.prop.toFixed(2)}% of home value in 2024, ranked ${ord(co.propRank)} of 50 (Tax Foundation). But homes cost more than in most states: the median Colorado house (single-family) sold for about ${round1k(co.homeHouse)} in ${zMonth}, and the median for all home types including condos was about ${round1k(co.home)} (Redfin), the ${ord(homeRank)} highest of the ${priced.length - 1} states and D.C. with Redfin data. With a median household income of ${money(co.income)} (Census, 2025), the all-homes median is ${co.ratio.toFixed(2)} times income. Pick your state above to compare.`],
  ['Which states have no income tax on wages?', `${listAnd(noIncome)} have no individual income tax on wages for 2026 (Tax Foundation; Washington taxes only certain capital gains). These states collect more in other ways: Texas, for example, has one of the higher property tax rates (about ${tx.prop.toFixed(2)}% of home value).`],
  ['How much is homeowners insurance in Colorado?', `Insurify reports an average of ${money(co.ins)} a year in Colorado for a policy with $300,000 of dwelling coverage, compared with a national average of ${money(data.usIns)}. Your price depends on the home, the roof, the deductible and the location, so get a quote on the actual house before you write an offer.`],
  ['Are property taxes really low in Colorado?', `The statewide average is low: about ${co.prop.toFixed(2)}% of home value, compared with ${data.usProp.toFixed(2)}% for the U.S. Your actual bill depends on the county, the city, the school district and, in many newer neighborhoods, a metro district tax that can add a noticeable amount. Always check the tax bill of the exact home before you buy.`],
  ['Can I get pre-approved for a Colorado mortgage before I move?', 'Yes. Tamila is a mortgage loan officer licensed in Colorado and Florida, so she can pre-approve you while you still live in another state, and as a real estate agent she can show homes by live video if you cannot visit yet.'],
  ['What is the affordability ratio?', `It is the median home sale price divided by the median household income in the state. A ratio of 5 means the typical home costs about five years of a typical household's income before taxes. Colorado's ratio is ${co.ratio.toFixed(2)}, ${ord(ratioRank)} highest of the ${priced.length - 1} states and D.C. with Redfin data. It is a rough comparison only: it does not include interest rates, down payment, taxes or your own income and debts.`],
  ['Why are these numbers different from other charts online?', 'Sources measure different things: some use median sale prices, some use typical home values or list prices; insurance averages depend on the coverage amount the company assumes. Every number here has its source and date listed below, and the page is updated when new data comes out.'],
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Moving to Colorado: State Tax and Home Cost Comparison', url: `${site.url}/moving-to-colorado`, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, author: { '@id': `${site.url}/#tamila` }, description: 'Pick the state you are moving from and compare its income tax, sales tax, property tax, homeowners insurance and typical home value with Colorado, for your own income and home price.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Moving to Colorado? Taxes & Home Costs vs Your State" description="Moving to Colorado? Pick your state and compare 2026 taxes, home insurance, median home sale prices and affordability with Colorado. Free, with sources." schema={schema}>
  <section class="section calc-hero">
    <div class="wrap narrow center stack">
      <p class="eyebrow">Free tool · All 50 states + D.C. · Home sale prices {zMonth}</p>
      <h1>Moving to Colorado? See How Your State Compares</h1>
      <p class="lead">Enter your income and pick up to 5 states. See what the typical home in each state would cost you every month, how much of your paycheck it takes, and what you pay each year in state taxes, compared with Colorado. Every number has a source.</p>
    </div>
  </section>

  <section class="section calc-wrap">
    <div class="wrap">
      <form class="mv" id="mv" onsubmit="return false">
        <label class="mv__from">Compare Colorado with up to 5 states
          <select id="add">
            <option value="">+ Add a state…</option>
            {others.map((r: any) => <option value={r.s}>{r.s === 'District of Columbia' ? 'Washington, D.C.' : r.s}</option>)}
          </select>
        </label>
        <div class="picked" id="picked" aria-label="States you are comparing"></div>
        <div class="chips" aria-label="Popular states"><span class="chips__l">Popular:</span>
          {popular.map((p) => <button type="button" class="chip" data-s={p}>{p}</button>)}
        </div>
        <div class="you">
          <label class="you__inc">Your household income (before taxes)
            <span class="money"><input id="income" type="number" inputmode="numeric" min="0" step="5000" value="100000" /></span>
            <small>Total yearly pay for everyone buying the home, the same number a lender uses.</small>
          </label>
          <div class="you__f" role="group" aria-label="Filing status">
            <span class="you__l">Filing taxes as</span>
            <div class="seg" id="filingSeg"><button type="button" data-v="married" class="on">Married</button><button type="button" data-v="single">Single</button></div>
            <small>Head of household? Choose Single. This only changes state income tax.</small>
            <input type="hidden" id="filing" value="married" />
          </div>
          <div class="you__f" role="group" aria-label="Down payment">
            <span class="you__l">Down payment</span>
            <div class="seg" id="dpSeg"><button type="button" data-v="3">3%</button><button type="button" data-v="5" class="on">5%</button><button type="button" data-v="10">10%</button><button type="button" data-v="20">20%</button></div>
            <small>You don't need 20% down: many buyers put 3% to 5% down (FHA 3.5%, VA 0%).</small>
            <input type="hidden" id="dp" value="5" />
          </div>
          <div class="you__f you__home" role="group" aria-label="Home price">
            <span class="you__l">Home price</span>
            <div class="seg" id="modeSeg"><button type="button" data-v="typical" class="on">Typical home in each state</button><button type="button" data-v="same">Same price everywhere</button></div>
            <div class="seg seg--sm" id="typeSeg"><button type="button" data-v="houses" class="on">Houses only</button><button type="button" data-v="all">All homes (incl. condos)</button></div>
            <input type="hidden" id="ptype" value="houses" />
            <span class="money" id="priceWrap" hidden><input id="price" type="number" inputmode="numeric" min="50000" step="5000" value="500000" aria-label="Home price in every state" /></span>
            <input type="hidden" id="mode" value="typical" />
          </div>
        </div>
        <details class="more">
          <summary>More options: interest rate and shopping</summary>
          <div class="grid3">
            <label>Interest rate (30-year fixed)
              <span class="pct"><input id="rate" type="number" inputmode="decimal" min="1" max="15" step="0.01" value="6.75" /></span>
              <small id="rateHint">Loading this week's national average…</small>
            </label>
            <label>Money you spend each year on things with sales tax
              <span class="money"><input id="spend" type="number" inputmode="numeric" min="0" step="1000" value="25000" /></span>
              <small>Shopping, cars, restaurants and other taxed purchases. Only changes the sales tax line.</small>
            </label>
          </div>
        </details>
      </form>

      <div class="card" aria-live="polite">
        <div class="card__head" id="headline"></div>
        <div class="cmp-wrap"><table class="cmpt" id="cmpt"></table></div>
        <p class="swipe">Swipe the table sideways to see every state →</p>
        <ul class="notes" id="notes"></ul>
        <p class="assume" id="assume"></p>
        <div class="btns"><a class="pill" href="#contact">Get a free Colorado moving plan</a><button type="button" class="pill pill--line" id="share">Copy link to this comparison</button></div>
        <ul class="disc-states" id="discStates"></ul>
        <p class="out__small">Estimates for comparison only, not tax, insurance or legal advice. See the disclosures below the table.</p>
      </div>
    </div>
  </section>

  <section class="section disclosures" id="disclosures">
    <div class="wrap">
      <div class="dx">
        <div class="dx__col">
          <h2>How to Read These Numbers</h2>
          <dl class="dx__defs">
            <dt>Median home sale price</dt>
            <dd>The price in the middle of all homes that actually sold in a month: half sold for more, half for less. It is a real sale price, not a list price or an online estimate. <b>Houses only</b> means single-family homes; <b>All homes</b> also includes condos and townhomes, which usually cost less, so that median is lower (Colorado, {zMonth}: {money(co.homeHouse)} for houses vs {money(co.home)} for all homes). Source: Redfin, {zMonth}{la ? `; Louisiana from statewide MLS data, ${laMonth}` : ''}.</dd>
            <dt>Median vs average: why your number may look different</dt>
            <dd>The <b>average</b> adds up every sale and divides by the number of sales, so a few very expensive homes pull it up. The <b>median</b> is the middle sale and is not moved by a handful of mansions, which is why economists and housing market reports use it to describe a typical home. {la && <>Example: in Louisiana in {laMonth}, the <b>median</b> sale price was <b>{money(la.price)}</b>, but the <b>average</b> was <b>{money(la.average)}</b>, about {Math.round((la.average / la.price - 1) * 100)}% higher. Both are correct; they answer different questions.</>} If you have seen a higher "average price" for your state, it is usually an average, a list price, or a different month or area.</dd>
            <dt>Median household income</dt>
            <dd>The income in the middle of all households in the state: half earn more, half earn less. "Household" means everyone living in one home, before taxes. Source: U.S. Census Bureau, American Community Survey 2025.</dd>
            <dt>Affordability ratio</dt>
            <dd>Median home sale price divided by median household income. It shows how many years of a typical household's income a typical home costs. Colorado: {money(co.home)} ÷ {money(co.income)} = <b>{co.ratio.toFixed(2)}</b>. The lower the ratio, the easier homes are to afford on local incomes; the higher, the harder. It does not include interest rates, down payment, taxes or your own income and debts, so it is a guide, not a loan approval.</dd>
            <dt>Monthly home payment and share of income</dt>
            <dd>The mortgage payment (with mortgage insurance if you put less than 20% down) plus property tax and home insurance, per month. "Share of your income" is that payment times 12 divided by your income before taxes, the same way a lender looks at it. By default each state uses its own typical (median) home price, so you see what living there would really cost; switch to "Same price everywhere" to compare one house.</dd>
            <dt>Total per year</dt>
            <dd>Twelve monthly home payments plus state income tax and sales tax for your household.</dd>
          </dl>
        </div>
        <div class="dx__col">
          <h2>Important Disclosures</h2>
          <ul class="dx__list">
            <li><b>Estimates only.</b> This tool compares state averages to help you plan. It is not tax, insurance, legal or financial advice, and it does not replace quotes and advice for a specific home. Tamila Aspen is a Colorado Real Estate Agent and a Mortgage Loan Officer in Colorado and Florida, not a tax advisor or insurance agent.</li>
            <li><b>Home insurance varies the most.</b> The numbers are statewide averages from Insurify for a policy with $300,000 of dwelling coverage. Your premium can be several times higher or lower depending on wildfire, hurricane, hail and flood risk where the home is, the age of the home and roof, the coverage and deductible you choose, and your claims history. In some high-risk areas, such as wildfire zones in California, regular coverage can be hard to find. Always get insurance quotes for the exact address before you make an offer.</li>
            <li><b>Flood is not included.</b> Most homeowners insurance does not cover flood damage (FEMA). Flood insurance is a separate policy and is not part of these totals.</li>
            <li><b>Property tax depends on the address.</b> Rates are statewide averages for owner-occupied homes in 2024 (Tax Foundation). County, city, school district and special district taxes, assessments and exemptions change the real bill, and the same home price is used for every state.</li>
            <li><b>Income tax is simplified.</b> You enter income before taxes. The tool subtracts each state's 2026 standard deduction and personal exemption (Tax Foundation) and applies the state's rates for married or single filers. Itemized deductions, dependents, income phase-outs, other credits and local income taxes that some cities and counties charge are not included.</li>
            <li><b>Mortgage payment is an estimate.</b> It assumes a 30-year fixed loan at this week's national average rate (Freddie Mac) unless you change it, the down payment you choose and, with less than 20% down, private mortgage insurance estimated at 0.5% of the loan a year. HOA dues, closing costs, FHA and VA fees are not included. Your rate and payment depend on your credit, income and loan program. This is not a loan offer or commitment to lend. Loans through Barrett Financial Group, LLC, NMLS #181106; Tamila Aspen, NMLS #2490507. Equal Housing Opportunity.</li>
            <li><b>Sales tax is an average.</b> It uses the average combined state and local rate. Many states tax groceries, medicine and services differently.</li>
            <li><b>Home prices.</b> Median sale prices are from Redfin for {zMonth}, not seasonally adjusted: "Houses only" uses single-family homes, "All homes" includes condos, townhomes and small multi-family. Redfin does not publish Louisiana, so Louisiana uses statewide MLS data for all home types{la ? ` for ${laMonth}` : ''} in both views. Prices change every month and differ a lot between cities in the same state.</li>
            <li><b>Data changes.</b> Sources and dates are listed below. The page is updated as new data is published, but numbers can change at any time.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>What Changes When You Move to Colorado</h2>
      <p><b>Low property tax, higher home prices.</b> Colorado homeowners paid about {co.prop.toFixed(2)}% of their home's value in property tax in 2024, ranked {ord(co.propRank)} of 50 states (the U.S. average was {data.usProp.toFixed(2)}%). The trade-off is price: the median Colorado house sold for about {round1k(co.homeHouse)} in {zMonth} ({round1k(co.home)} for all home types including condos), and all home types together rank {ord(homeRank)} highest of the {priced.length - 1} states and D.C. with Redfin data. With a median household income of {money(co.income)}, the typical home costs {co.ratio.toFixed(2)} times income, compared with an average of {usRatio.toFixed(2)} across them.</p>
      <p><b>A flat income tax.</b> Colorado taxes income at one rate, 4.40% for 2026. From a state with a high top rate, most households pay less; from one of the {noIncome.length} states with no tax on wages, you will start paying it, so compare property tax and insurance too.</p>
      <p><b>"No income tax" is not the whole story.</b> Texas has no income tax but a property tax rate of about {tx.prop.toFixed(2)}% of home value. Florida's average home insurance is {money(fl.ins)} a year for $300,000 of coverage, compared with {money(co.ins)} in Colorado.</p>
      <p><b>Check the exact home.</b> Many newer Colorado neighborhoods are in a metro district that adds to the tax bill, and many have HOA dues. Insurance depends on the roof and the deductible. Tamila checks these for every home before you write an offer.</p>
      <div class="btns"><a class="pill" href="/buy-a-home">Buying a home in Colorado</a><a class="pill pill--line" href="/mortgage-calculator">Monthly payment calculator</a><a class="pill pill--line" href="/areas">Denver area guides</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Moving to Colorado With One Person for the Home and the Loan</h2>
      <ul class="checks">
        <li><b>Pre-approval before you move.</b> Tamila is a mortgage loan officer licensed in Colorado and Florida, with FHA, VA, conventional, jumbo and programs from a 500 credit score.</li>
        <li><b>Live video tours.</b> If you cannot fly in for every showing, she walks the home with you on a video call.</li>
        <li><b>Selling a Colorado home too?</b> When you sell and buy your next home with Tamila, her listing fee is 1%. Listing only: standard rate, up to 3%.</li>
        <li><b>Military moves.</b> Moving on PCS orders? See <a href="/va-loans-pcs">VA loans and PCS moves</a>.</li>
        <li><b>English, Russian and Ukrainian.</b></li>
      </ul>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>Sources</h2>
      <ul>
        <li><a href="https://taxfoundation.org/data/all/state/state-income-tax-rates-2026/" rel="noopener" target="_blank">Tax Foundation: State Individual Income Tax Rates and Brackets, 2026</a> (rates and brackets as of January 1, 2026)</li>
        <li><a href="https://taxfoundation.org/data/all/state/2026-sales-tax-rates-midyear/" rel="noopener" target="_blank">Tax Foundation: State and Local Sales Tax Rates, Midyear 2026</a> (state plus average local rate)</li>
        <li><a href="https://taxfoundation.org/wp-content/uploads/2026/04/TaxFoundation_FactsFigures26-3-31.pdf" rel="noopener" target="_blank">Tax Foundation: Facts &amp; Figures 2026, Table 33, Property Taxes Paid as a Percentage of Owner-Occupied Housing Value</a> (2024, from Census ACS)</li>
        <li><a href="https://insurify.com/homeowners-insurance/states/" rel="noopener" target="_blank">Insurify: Average Home Insurance Rates by State</a> ($300,000 dwelling coverage)</li>
        <li><a href="https://www.redfin.com/news/data-center/housing-market/" rel="noopener" target="_blank">Redfin Data Center: Housing Market Tracker, median sale price by state, {zMonth}</a> (all residential, not seasonally adjusted; Redfin does not publish Louisiana)</li>
        {la && <li><a href={la.url} rel="noopener" target="_blank">ShowingTime Monthly Indicators for Louisiana: statewide MLS data, {laMonth}</a> (median and average sale price for Louisiana)</li>}
        <li><a href="https://www.census.gov/programs-surveys/acs/data/summary-file.html" rel="noopener" target="_blank">U.S. Census Bureau: American Community Survey 2025 1-year estimates, table B19013, median household income</a></li>
        <li><a href="https://agents.floodsmart.gov/sites/default/files/media/document/2025-08/fema_nfip-most-homeowners-insurance-does-not-cover-flood-damage_postcard_08-2025.pdf" rel="noopener" target="_blank">FEMA / National Flood Insurance Program: Most homeowners insurance does not cover flood damage</a></li>
        <li><a href="https://www.insurance.ca.gov/0200-industry/0105-alert/upload/FAIR-Plan-growth-slows-below-2-as-Californias-insurance-market-continues-to-show-signs-of-recovery.pdf" rel="noopener" target="_blank">California Department of Insurance: FAIR Plan update, August 2026</a></li>
        <li><a href="https://www.cbsnews.com/colorado/news/hail-driving-colorado-high-insurance-rates" rel="noopener" target="_blank">CBS Colorado: Colorado Division of Insurance data on hail and wildfire in homeowners premiums (February 2026)</a></li>
      </ul>
      <p>Tax and insurance data last checked: {taxChecked}. Home sale prices update automatically each month; household income once a year.</p>
    </div>
  </section>

  <Faq items={faq} title="Moving to Colorado Questions" />
  <ContactBand title="Planning a Move to Colorado?" lead="Tell Tamila where you are moving from, your budget and your timeline. She will send neighborhoods to look at, real tax and insurance numbers for homes you like, and a pre-approval plan, free." goal="Buy a home" />
</Base>

<script define:vars={{ states, MONTH: zMonth }}>
  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '$' + Math.round(n).toLocaleString('en-US');
  const pct = (n) => (Math.round(n * 100) / 100).toFixed(2).replace(/\.?0+$/, '') + '%';
  const find = (n) => states.find((r) => r.s === n);
  const label = (n) => (n === 'District of Columbia' ? 'Washington, D.C.' : n);
  const CO = find('Colorado');
  const tax = (inc, br) => {
    let t = 0;
    for (let i = 0; i < br.length; i++) {
      const [from, rate] = br[i];
      const to = i + 1 < br.length ? br[i + 1][0] : Infinity;
      if (inc > from) t += (Math.min(inc, to) - from) * rate / 100;
    }
    return t;
  };
  const rateText = (r) => {
    if (r.incomeNote) return r.incomeNote;
    const b = r.single;
    if (!b.length) return 'No income tax';
    if (b.length === 1) return b[0][0] > 0 ? `${pct(b[0][1])} above ${fmt(b[0][0])}` : `${pct(b[0][1])} flat`;
    return `${pct(b[0][1])} to ${pct(b[b.length - 1][1])}`;
  };
  const slug = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-');
  const MAX = 5;
  const DISC = {
    California: 'The state average hides big differences. In wildfire-prone areas, many owners have had trouble finding regular coverage and use the California FAIR Plan, which the state describes as temporary coverage while the regular market recovers. Expect much higher costs there and get quotes before you make an offer.',
    Florida: 'Hurricane and wind risk drive prices: coastal homes can cost far more to insure than the state average. Flood is a separate policy.',
    Louisiana: 'Hurricane and wind risk drive prices: coastal homes can cost far more to insure than the state average. Flood is a separate policy.',
    Texas: 'Coastal homes (hurricanes) and hail-prone areas can cost much more to insure than the state average. Flood is a separate policy.',
    Colorado: 'Hail is the biggest driver: data from the Colorado Division of Insurance show hail makes up 26% to 54% of homeowners premiums and wildfire 1% to 25%, depending on the county. Homes near forests can cost much more to insure.',
  };
  let picked = ['California'];
  const params = new URLSearchParams(location.search);
  if (params.get('from')) {
    const want = params.get('from').split(',').map((x) => states.find((r) => slug(r.s) === x)).filter((r) => r && r.s !== 'Colorado').map((r) => r.s);
    if (want.length) picked = [...new Set(want)].slice(0, MAX);
  }
  const segs = { filing: 'filingSeg', dp: 'dpSeg', mode: 'modeSeg', ptype: 'typeSeg' };
  const setSeg = (k, v) => { $(k).value = v; $(segs[k]).querySelectorAll('button').forEach((b) => b.classList.toggle('on', b.dataset.v === v)); if (k === 'mode') { $('priceWrap').hidden = v !== 'same'; $('typeSeg').hidden = v === 'same'; } };
  let rateTouched = false;
  ['income', 'price', 'spend', 'rate'].forEach((k) => { if (params.get(k)) { $(k).value = params.get(k); if (k === 'rate') rateTouched = true; } });
  ['filing', 'dp', 'mode', 'ptype'].forEach((k) => { if (params.get(k)) setSeg(k, params.get(k)); });
  Object.entries(segs).forEach(([k, id]) => $(id).querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { setSeg(k, b.dataset.v); run(); })));

  function calc(r, o) {
    const f = o.filing === 'married' ? 1 : 0;
    const taxable = Math.max(0, o.inc - (r.sd?.[f] || 0) - (r.ex?.[f] || 0));
    const it = Math.max(0, tax(taxable, f ? r.married : r.single) - (r.cr?.[f] || 0));
    const st = o.spend * r.sales / 100;
    const typical = o.ptype === 'houses' ? (r.homeHouse ?? r.home) : r.home;
    const price = o.mode === 'same' ? o.price : typical;
    if (!price) return { it, st, price: null, ratio: null, total: null };
    const loan = price * (1 - o.dp / 100), i = o.rate / 100 / 12, n = 360;
    const pi = i ? loan * i / (1 - Math.pow(1 + i, -n)) : loan / n;
    const pmi = o.dp < 20 ? loan * 0.005 / 12 : 0;
    const ptm = price * r.prop / 100 / 12, insm = r.ins / 12;
    const month = pi + pmi + ptm + insm;
    const ratio = typical && r.income ? typical / r.income : null;
    return { it, st, price, ratio, pi, pmi, ptm, insm, month, share: o.inc ? month * 12 / o.inc * 100 : 0, down: price * o.dp / 100, total: month * 12 + it + st };
  }
  function addState(n) {
    if (!n || n === 'Colorado') return;
    if (picked.includes(n)) { picked = picked.filter((x) => x !== n); }
    else if (picked.length < MAX) picked.push(n);
    run();
  }
  function run() {
    const o = { ptype: $('ptype').value, inc: +$('income').value || 0, filing: $('filing').value, dp: +$('dp').value, mode: $('mode').value, price: +$('price').value || 0, spend: +$('spend').value || 0, rate: +$('rate').value || 0 };
    const cols = [...picked.map(find), CO];
    const res = cols.map((r) => calc(r, o));
    const co = res[res.length - 1];
    $('picked').innerHTML = picked.map((n) => `<button type="button" class="pk" data-s="${n}" aria-label="Remove ${label(n)}">${label(n)} <span aria-hidden="true">×</span></button>`).join('')
      + (picked.length >= MAX ? '<span class="pk__max">Maximum 5 states</span>' : '');
    $('picked').querySelectorAll('.pk').forEach((b) => b.addEventListener('click', () => { picked = picked.filter((x) => x !== b.dataset.s); run(); }));
    $('add').value = ''; $('add').disabled = picked.length >= MAX;
    [...$('add').options].forEach((op) => { if (op.value) op.disabled = picked.includes(op.value); });
    document.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', picked.includes(c.dataset.s)));
    const cls = (r) => (r.s === 'Colorado' ? 'co' : '');
    const head = '<tr><th></th>' + cols.map((r) => `<th scope="col" class="${cls(r)}">${label(r.s)}</th>`).join('') + '</tr>';
    const row = (name, f, sub, trc = '') => `<tr class="${trc}"><th scope="row">${name}</th>` + cols.map((r, i) => `<td class="${cls(r)}"><em>${f(res[i], r)}</em>${sub ? `<small>${sub(res[i], r)}</small>` : ''}</td>`).join('') + '</tr>';
    const dash = '—';
    const diffRow = '<tr class="diff"><th scope="row">Colorado vs this state</th>' + cols.map((r, i) => {
      if (r.s === 'Colorado') return '<td class="co">—</td>';
      if (res[i].total == null || co.total == null) return '<td>—</td>';
      const d = co.total - res[i].total;
      return `<td><b class="${d > 0 ? 'up' : d < 0 ? 'down' : ''}">${Math.abs(d) < 100 ? 'about the same' : (d > 0 ? '+' : '−') + fmt(Math.abs(d)) + '/yr'}</b></td>`;
    }).join('') + '</tr>';
    $('cmpt').innerHTML = '<thead>' + head + '</thead><tbody>'
      + row('Home price', (x) => (x.price ? fmt(x.price) : 'No data'), (x, r) => (o.mode === 'same' ? 'your price' : (o.ptype === 'houses' && r.homeHouse ? 'median house, ' : o.ptype === 'houses' ? 'median, all homes, ' : 'median, all homes, ') + (r.priceLabel || 'Redfin ' + MONTH)))
      + row('Monthly home payment', (x) => (x.price ? fmt(x.month) + '/mo' : dash), (x) => (x.price ? `loan ${fmt(x.pi + x.pmi)} · tax ${fmt(x.ptm)} · insurance ${fmt(x.insm)}` : ''), 'big')
      + row('Share of your income', (x) => (x.price ? Math.round(x.share) + '%' : dash), () => 'home payment ÷ income')
      + row('Down payment', (x) => (x.price ? fmt(x.down) : dash), () => o.dp + '% + closing costs')
      + row('State income tax', (x) => fmt(x.it) + '/yr', rateText.length ? (x, r) => rateText(r) : null)
      + row('Sales tax', (x) => fmt(x.st) + '/yr', (x, r) => pct(r.sales) + ' combined')
      + `<tr class="tot"><th scope="row">Total per year</th>` + cols.map((r, i) => `<td class="${cls(r)}"><b>${res[i].total != null ? fmt(res[i].total) : dash}</b><small>home payments + taxes</small></td>`).join('') + '</tr>'
      + diffRow
      + row('Median household income', (x, r) => (r.income ? fmt(r.income) : dash), () => 'Census, 2025')
      + row('Affordability ratio', (x) => (x.ratio ? x.ratio.toFixed(2) + '×' : dash), () => (o.ptype === 'houses' ? 'median house' : 'median home') + ' ÷ median income')
      + '</tbody>';
    const lines = picked.map((n, i) => {
      const x = res[i];
      if (x.total == null || co.total == null) return `From <b>${label(n)}</b>: no published median sale price, so only taxes are compared.`;
      const dm = co.month - x.month, d = co.total - x.total;
      const homeTxt = o.mode === 'same' ? 'the same home' : o.ptype === 'houses' ? 'the typical house' : 'the typical home';
      return `From <b>${label(n)}</b>: ${homeTxt} costs <b class="${dm > 0 ? 'up' : 'down'}">${fmt(Math.abs(dm))} ${dm > 0 ? 'more' : 'less'} a month</b> in Colorado; all in, about <b class="${d > 0 ? 'up' : 'down'}">${fmt(Math.abs(d))} ${d > 0 ? 'more' : 'less'} a year</b>.`;
    });
    $('headline').innerHTML = picked.length ? '<ul class="hl">' + lines.map((l) => `<li>${l}</li>`).join('') + '</ul>' : '<p>Add a state above to compare it with Colorado.</p>';
    $('notes').innerHTML = co.price ? `<li>In Colorado, a ${fmt(co.price)} home with ${o.dp}% down would take about <b>${Math.round(co.share)}%</b> of a ${fmt(o.inc)} income. Want to know what you would qualify for? Tamila can pre-approve you before you move.</li>` : '';
    const shown = [...picked, 'Colorado'].filter((n) => DISC[n]);
    $('discStates').innerHTML = shown.map((n) => `<li><b>${label(n)} insurance:</b> ${DISC[n]}</li>`).join('');
    $('assume').textContent = `Based on ${fmt(o.inc)} household income before taxes (${o.filing === 'married' ? 'married' : 'single'}), ${o.dp}% down, a 30-year fixed loan at ${o.rate.toFixed(2)}%${o.dp < 20 ? ', estimated mortgage insurance' : ''}, ${o.mode === 'same' ? 'the same ' + fmt(o.price) + ' home in every state' : (o.ptype === 'houses' ? 'the median house (single-family) sale price in each state' : 'the median sale price of all home types in each state')} and ${fmt(o.spend)} a year of taxed purchases.`;
  }
  $('mv').addEventListener('input', (e) => { if (e.target.id === 'rate') rateTouched = true; if (e.target.id !== 'add') run(); });
  $('add').addEventListener('change', () => addState($('add').value));
  document.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => addState(c.dataset.s)));
  fetch('/api/rates').then((r) => r.json()).then((d) => {
    if (d && d.rate30 && !rateTouched) {
      $('rate').value = (+d.rate30).toFixed(2);
      const dt = d.date ? new Date(d.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
      $('rateHint').textContent = `This week's national average (Freddie Mac${dt ? ', ' + dt : ''}). Your rate depends on credit and loan.`;
      run();
    }
  }).catch(() => { $('rateHint').textContent = 'Average rate estimate. Your rate depends on credit and loan.'; });
  $('share').addEventListener('click', () => {
    const p = new URLSearchParams({ from: picked.map(slug).join(','), income: $('income').value, filing: $('filing').value, dp: $('dp').value, mode: $('mode').value, ptype: $('ptype').value });
    if ($('mode').value === 'same') p.set('price', $('price').value);
    const url = location.origin + location.pathname + '?' + p.toString();
    navigator.clipboard?.writeText(url).then(() => { $('share').textContent = 'Link copied'; setTimeout(() => ($('share').textContent = 'Copy link to this comparison'), 2000); });
  });
  run();
</script>

