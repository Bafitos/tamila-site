---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site.js';
import zhvi from '../data/zhvi.json';
import data from '../data/state-costs.json';

// Tax and insurance data: src/data/state-costs.json (verified from primary sources; refreshed by the twice-yearly scheduled task).
// Home values: src/data/zhvi.json, refreshed monthly by .github/workflows/zhvi-monthly.yml.
const taxChecked = 'November 2026';
const states = data.states
  .map((r: any) => ({ ...r, home: (zhvi.values as Record<string, number>)[r.s] ?? null }))
  .sort((a: any, b: any) => a.s.localeCompare(b.s));
const co = states.find((r: any) => r.s === 'Colorado');
const others = states.filter((r: any) => r.s !== 'Colorado');
const by = (n: string) => states.find((r: any) => r.s === n);
const zMonth = new Date(zhvi.month + 'T12:00:00Z').toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const ord = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
const listAnd = (a: string[]) => a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];
const round1k = (n: number) => '$' + (Math.round(n / 1000) * 1000).toLocaleString('en-US');
const homeRank = [...states].filter((r: any) => r.home).sort((a: any, b: any) => b.home - a.home).findIndex((r: any) => r.s === 'Colorado') + 1;
const noIncome = states.filter((r: any) => r.single.length === 0).map((r: any) => r.s);
const tx = by('Texas'), fl = by('Florida');
const popular = ['California', 'Texas', 'Florida', 'Illinois', 'New York', 'Arizona', 'Washington', 'Georgia'];

const faq = [
  ['Is Colorado a tax-friendly state to move to?', `It depends on where you are coming from. Colorado has a flat 4.40% income tax for 2026, and its property taxes are among the lowest in the country: about ${co.prop.toFixed(2)}% of home value in 2024, ranked ${ord(co.propRank)} of 50 (Tax Foundation). But homes cost more than in most states: the typical Colorado home value was about ${round1k(co.home)} in ${zMonth} (Zillow), ${ord(homeRank)} highest of 50 states and D.C. Pick your state above to compare.`],
  ['Which states have no income tax on wages?', `${listAnd(noIncome)} have no individual income tax on wages for 2026 (Tax Foundation; Washington taxes only certain capital gains). These states collect more in other ways: Texas, for example, has one of the higher property tax rates (about ${tx.prop.toFixed(2)}% of home value).`],
  ['How much is homeowners insurance in Colorado?', `Insurify reports an average of ${money(co.ins)} a year in Colorado for a policy with $300,000 of dwelling coverage, compared with a national average of ${money(data.usIns)}. Your price depends on the home, the roof, the deductible and the location, so get a quote on the actual house before you write an offer.`],
  ['Are property taxes really low in Colorado?', `The statewide average is low: about ${co.prop.toFixed(2)}% of home value, compared with ${data.usProp.toFixed(2)}% for the U.S. Your actual bill depends on the county, the city, the school district and, in many newer neighborhoods, a metro district tax that can add a noticeable amount. Always check the tax bill of the exact home before you buy.`],
  ['Can I get pre-approved for a Colorado mortgage before I move?', 'Yes. Tamila is a mortgage loan officer licensed in Colorado and Florida, so she can pre-approve you while you still live in another state, and as a real estate agent she can show homes by live video if you cannot visit yet.'],
  ['Why are these numbers different from other charts online?', 'Sources measure different things: some use median home prices, some use typical values; insurance averages depend on the coverage amount the company assumes. Every number here has its source and date listed below, and the page is updated when new data comes out.'],
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Moving to Colorado: State Tax and Home Cost Comparison', url: `${site.url}/moving-to-colorado`, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, author: { '@id': `${site.url}/#tamila` }, description: 'Pick the state you are moving from and compare its income tax, sales tax, property tax, homeowners insurance and typical home value with Colorado, for your own income and home price.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Moving to Colorado? Taxes & Home Costs vs Your State" description="Moving to Colorado? Pick your state and compare 2026 income tax, sales tax, property tax, home insurance and home values with Colorado. Free, with sources." schema={schema}>
  <section class="section calc-hero">
    <div class="wrap narrow center stack">
      <p class="eyebrow">Free tool · All 50 states + D.C. · Home values {zMonth}</p>
      <h1>Moving to Colorado? See How Your State Compares</h1>
      <p class="lead">Pick the state you live in now, or up to 5 states you are deciding between. You will see what the same household pays each year in state income tax, sales tax, property tax and home insurance in each of them and in Colorado. Every number has a source.</p>
    </div>
  </section>

  <section class="section calc-wrap">
    <div class="wrap">
      <form class="mv" id="mv" onsubmit="return false">
        <label class="mv__from">Compare Colorado with up to 5 states
          <select id="add">
            <option value="">+ Add a state…</option>
            {others.map((r: any) => <option value={r.s}>{r.s === 'District of Columbia' ? 'Washington, D.C.' : r.s}</option>)}
          </select>
        </label>
        <div class="picked" id="picked" aria-label="States you are comparing"></div>
        <div class="chips" aria-label="Popular states"><span class="chips__l">Popular:</span>
          {popular.map((p) => <button type="button" class="chip" data-s={p}>{p}</button>)}
        </div>
        <details class="more">
          <summary>Use my own income and home price</summary>
          <div class="grid3">
            <label>Household taxable income
              <span class="money"><input id="income" type="number" inputmode="numeric" min="0" step="1000" value="100000" /></span>
            </label>
            <label>Filing status
              <select id="filing"><option value="single">Single</option><option value="married">Married filing jointly</option></select>
            </label>
            <label>Home price
              <span class="money"><input id="price" type="number" inputmode="numeric" min="50000" step="5000" value="500000" /></span>
            </label>
            <label>Yearly spending on taxable goods
              <span class="money"><input id="spend" type="number" inputmode="numeric" min="0" step="1000" value="25000" /></span>
            </label>
          </div>
          <p class="hint">Taxable income is after deductions. Sales tax uses the average combined state and local rate; groceries and other items are taxed differently in each state.</p>
        </details>
      </form>

      <div class="card" aria-live="polite">
        <div class="card__head" id="headline"></div>
        <div class="cmp-wrap"><table class="cmpt" id="cmpt"></table></div>
        <p class="swipe">Swipe the table sideways to see every state →</p>
        <ul class="notes" id="notes"></ul>
        <p class="assume" id="assume"></p>
        <div class="btns"><a class="pill" href="#contact">Get a free Colorado moving plan</a><button type="button" class="pill pill--line" id="share">Copy link to this comparison</button></div>
        <p class="out__small">Estimates for comparison only, not tax advice. Local rates vary by county and city; Colorado homes in a metro district pay more property tax. Insurance is a state average for $300,000 of dwelling coverage.</p>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>What Changes When You Move to Colorado</h2>
      <p><b>Low property tax, higher home prices.</b> Colorado homeowners paid about {co.prop.toFixed(2)}% of their home's value in property tax in 2024, ranked {ord(co.propRank)} of 50 states (the U.S. average was {data.usProp.toFixed(2)}%). The trade-off is price: a typical Colorado home was worth about {round1k(co.home)} in {zMonth}, the {ord(homeRank)} highest of the 50 states and D.C.</p>
      <p><b>A flat income tax.</b> Colorado taxes income at one rate, 4.40% for 2026. From a state with a high top rate, most households pay less; from one of the {noIncome.length} states with no tax on wages, you will start paying it, so compare property tax and insurance too.</p>
      <p><b>"No income tax" is not the whole story.</b> Texas has no income tax but a property tax rate of about {tx.prop.toFixed(2)}% of home value. Florida's average home insurance is {money(fl.ins)} a year for $300,000 of coverage, compared with {money(co.ins)} in Colorado.</p>
      <p><b>Check the exact home.</b> Many newer Colorado neighborhoods are in a metro district that adds to the tax bill, and many have HOA dues. Insurance depends on the roof and the deductible. Tamila checks these for every home before you write an offer.</p>
      <div class="btns"><a class="pill" href="/buy-a-home">Buying a home in Colorado</a><a class="pill pill--line" href="/mortgage-calculator">Monthly payment calculator</a><a class="pill pill--line" href="/areas">Denver area guides</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Moving to Colorado With One Person for the Home and the Loan</h2>
      <ul class="checks">
        <li><b>Pre-approval before you move.</b> Tamila is a mortgage loan officer licensed in Colorado and Florida, with FHA, VA, conventional, jumbo and programs from a 500 credit score.</li>
        <li><b>Live video tours.</b> If you cannot fly in for every showing, she walks the home with you on a video call.</li>
        <li><b>Selling a Colorado home too?</b> When you sell and buy your next home with Tamila, her listing fee is 1%. Listing only: standard rate, up to 3%.</li>
        <li><b>Military moves.</b> Moving on PCS orders? See <a href="/va-loans-pcs">VA loans and PCS moves</a>.</li>
        <li><b>English, Russian and Ukrainian.</b></li>
      </ul>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>Sources</h2>
      <ul>
        <li><a href="https://taxfoundation.org/data/all/state/state-income-tax-rates-2026/" rel="noopener" target="_blank">Tax Foundation: State Individual Income Tax Rates and Brackets, 2026</a> (rates and brackets as of January 1, 2026)</li>
        <li><a href="https://taxfoundation.org/data/all/state/2026-sales-tax-rates-midyear/" rel="noopener" target="_blank">Tax Foundation: State and Local Sales Tax Rates, Midyear 2026</a> (state plus average local rate)</li>
        <li><a href="https://taxfoundation.org/wp-content/uploads/2026/04/TaxFoundation_FactsFigures26-3-31.pdf" rel="noopener" target="_blank">Tax Foundation: Facts &amp; Figures 2026, Table 33, Property Taxes Paid as a Percentage of Owner-Occupied Housing Value</a> (2024, from Census ACS)</li>
        <li><a href="https://insurify.com/homeowners-insurance/states/" rel="noopener" target="_blank">Insurify: Average Home Insurance Rates by State</a> ($300,000 dwelling coverage)</li>
        <li><a href="https://www.zillow.com/research/data/" rel="noopener" target="_blank">Zillow Research: Zillow Home Value Index (ZHVI), states, {zMonth}</a></li>
      </ul>
      <p>Tax and insurance data last checked: {taxChecked}. Home values update automatically each month.</p>
    </div>
  </section>

  <Faq items={faq} title="Moving to Colorado Questions" />
  <ContactBand title="Planning a Move to Colorado?" lead="Tell Tamila where you are moving from, your budget and your timeline. She will send neighborhoods to look at, real tax and insurance numbers for homes you like, and a pre-approval plan, free." goal="Buy a home" />
</Base>

<script define:vars={{ states }}>
  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '$' + Math.round(n).toLocaleString('en-US');
  const pct = (n) => (Math.round(n * 100) / 100).toFixed(2).replace(/\.?0+$/, '') + '%';
  const find = (n) => states.find((r) => r.s === n);
  const label = (n) => (n === 'District of Columbia' ? 'Washington, D.C.' : n);
  const CO = find('Colorado');
  const tax = (inc, br) => {
    let t = 0;
    for (let i = 0; i < br.length; i++) {
      const [from, rate] = br[i];
      const to = i + 1 < br.length ? br[i + 1][0] : Infinity;
      if (inc > from) t += (Math.min(inc, to) - from) * rate / 100;
    }
    return t;
  };
  const rateText = (r) => {
    if (r.incomeNote) return r.incomeNote;
    const b = r.single;
    if (!b.length) return 'No income tax';
    if (b.length === 1) return b[0][0] > 0 ? `${pct(b[0][1])} above ${fmt(b[0][0])}` : `${pct(b[0][1])} flat`;
    return `${pct(b[0][1])} to ${pct(b[b.length - 1][1])}`;
  };
  const slug = (s) => s.toLowerCase().replace(/[^a-z]+/g, '-');
  const MAX = 5;
  let picked = ['California'];
  const params = new URLSearchParams(location.search);
  if (params.get('from')) {
    const want = params.get('from').split(',').map((x) => states.find((r) => slug(r.s) === x)).filter((r) => r && r.s !== 'Colorado').map((r) => r.s);
    if (want.length) picked = [...new Set(want)].slice(0, MAX);
  }
  ['income', 'price', 'spend', 'filing'].forEach((k) => { if (params.get(k)) { $(k).value = params.get(k); $('mv').querySelector('details').open = true; } });

  function calc(r, inc, filing, price, spend) {
    const it = tax(inc, filing === 'married' ? r.married : r.single), st = spend * r.sales / 100, pt = price * r.prop / 100;
    return { it, st, pt, ins: r.ins, total: it + st + pt + r.ins };
  }
  function addState(n) {
    if (!n || n === 'Colorado') return;
    if (picked.includes(n)) { picked = picked.filter((x) => x !== n); }
    else if (picked.length < MAX) picked.push(n);
    run();
  }
  function run() {
    const inc = +$('income').value || 0, filing = $('filing').value, price = +$('price').value || 0, spend = +$('spend').value || 0;
    const cols = [...picked.map(find), CO];
    const res = cols.map((r) => calc(r, inc, filing, price, spend));
    const co = res[res.length - 1];
    // picked chips
    $('picked').innerHTML = picked.map((n) => `<button type="button" class="pk" data-s="${n}" aria-label="Remove ${label(n)}">${label(n)} <span aria-hidden="true">×</span></button>`).join('')
      + (picked.length >= MAX ? '<span class="pk__max">Maximum 5 states</span>' : '');
    $('picked').querySelectorAll('.pk').forEach((b) => b.addEventListener('click', () => { picked = picked.filter((x) => x !== b.dataset.s); run(); }));
    $('add').value = ''; $('add').disabled = picked.length >= MAX;
    [...$('add').options].forEach((o) => { if (o.value) o.disabled = picked.includes(o.value); });
    document.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', picked.includes(c.dataset.s)));
    // table
    const head = '<tr><th></th>' + cols.map((r) => `<th scope="col" class="${r.s === 'Colorado' ? 'co' : ''}">${label(r.s)}</th>`).join('') + '</tr>';
    const row = (name, f, sub) => `<tr><th scope="row">${name}</th>` + cols.map((r, i) => `<td class="${r.s === 'Colorado' ? 'co' : ''}"><em>${f(res[i], r)}</em>${sub ? `<small>${sub(r)}</small>` : ''}</td>`).join('') + '</tr>';
    const diffRow = '<tr class="diff"><th scope="row">Colorado vs this state</th>' + cols.map((r, i) => {
      if (r.s === 'Colorado') return '<td class="co">—</td>';
      const d = co.total - res[i].total;
      return `<td><b class="${d > 0 ? 'up' : d < 0 ? 'down' : ''}">${Math.abs(d) < 100 ? 'about the same' : (d > 0 ? '+' : '−') + fmt(Math.abs(d)) + '/yr'}</b></td>`;
    }).join('') + '</tr>';
    $('cmpt').innerHTML = '<thead>' + head + '</thead><tbody>'
      + row('State income tax', (x) => fmt(x.it), rateText)
      + row('Sales tax', (x) => fmt(x.st), (r) => pct(r.sales) + ' combined')
      + row('Property tax', (x) => fmt(x.pt), (r) => pct(r.prop) + ' of value')
      + row('Home insurance', (x) => fmt(x.ins), () => 'state average')
      + `<tr class="tot"><th scope="row">Total per year</th>` + cols.map((r, i) => `<td class="${r.s === 'Colorado' ? 'co' : ''}"><b>${fmt(res[i].total)}</b></td>`).join('') + '</tr>'
      + diffRow
      + row('Typical home value', (x, r) => (r.home ? fmt(r.home) : '—'), () => 'Zillow')
      + '</tbody>';
    // headline + notes
    const lines = picked.map((n, i) => {
      const d = co.total - res[i].total;
      return Math.abs(d) < 100 ? `From <b>${label(n)}</b>: about the <b>same</b> in Colorado` : `From <b>${label(n)}</b>: about <b class="${d > 0 ? 'up' : 'down'}">${fmt(Math.abs(d))} ${d > 0 ? 'more' : 'less'} a year</b> in Colorado`;
    });
    $('headline').innerHTML = picked.length ? '<ul class="hl">' + lines.map((l) => `<li>${l}</li>`).join('') + '</ul>' : '<p>Add a state above to compare it with Colorado.</p>';
    $('notes').innerHTML = picked.map((n) => {
      const r = find(n);
      if (!r.home || !CO.home) return '';
      const h = CO.home - r.home, p = Math.round(Math.abs(h) / r.home * 100);
      return `<li>Typical home in Colorado vs ${label(n)}: <b>${p}% ${h > 0 ? 'more expensive' : 'less expensive'}</b> (${fmt(CO.home)} vs ${fmt(r.home)})</li>`;
    }).join('');
    $('assume').textContent = `Based on ${fmt(inc)} taxable income (${filing === 'married' ? 'married filing jointly' : 'single'}), the same ${fmt(price)} home in every state and ${fmt(spend)} a year of taxable spending.`;
  }
  $('mv').addEventListener('input', (e) => { if (e.target.id !== 'add') run(); });
  $('add').addEventListener('change', () => addState($('add').value));
  document.querySelectorAll('.chip').forEach((c) => c.addEventListener('click', () => addState(c.dataset.s)));
  $('share').addEventListener('click', () => {
    const p = new URLSearchParams({ from: picked.map(slug).join(',') });
    if ($('mv').querySelector('details').open) ['income', 'filing', 'price', 'spend'].forEach((k) => p.set(k, $(k).value));
    const url = location.origin + location.pathname + '?' + p.toString();
    navigator.clipboard?.writeText(url).then(() => { $('share').textContent = 'Link copied'; setTimeout(() => ($('share').textContent = 'Copy link to this comparison'), 2000); });
  });
  run();
</script>

<style is:global>
  .calc-hero { padding-bottom: 8px; }
  .mv { display: grid; gap: 14px; max-width: 760px; margin: 0 auto; }
  .mv label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .95rem; }
  .mv input, .mv select { font: 400 1.1rem var(--font); color: var(--ink); background: var(--white); border: 1.5px solid var(--green-soft); border-radius: 12px; padding: 12px 14px; width: 100%; }
  .mv__from select { font-size: 1.3rem; padding: 14px 16px; border-width: 2px; border-color: var(--green); }
  .mv input:focus, .mv select:focus { outline: 2px solid var(--green); outline-offset: 1px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { border: 1px solid var(--green-soft); background: var(--white); color: var(--green); border-radius: 999px; padding: 6px 14px; font: 600 .9rem var(--font); cursor: pointer; }
  .chip:hover { background: var(--green-mist); }
  .mv .more { border: 1px solid var(--green-soft); border-radius: 16px; padding: 4px 18px 16px; }
  .mv .more summary { cursor: pointer; font-weight: 700; padding: 12px 0; }
  .grid3 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .mv .money { position: relative; display: block; }
  .mv .money input { padding-left: 28px; }
  .mv .money::before { content: '$'; position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 400; opacity: .7; }
  .hint { font-size: .88rem; opacity: .8; margin-top: 10px; }
  .card { margin-top: 24px; background: var(--green-mist); border-radius: 24px; padding: 26px; display: grid; gap: 16px; }
  .card__head { font-size: 1.25rem; line-height: 1.4; }
  .up { color: #a3412b; }
  .down { color: var(--green); }
  .picked { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .pk { border: 0; background: var(--green); color: var(--white); border-radius: 999px; padding: 8px 14px; font: 600 .95rem var(--font); cursor: pointer; }
  .pk span { margin-left: 4px; opacity: .8; }
  .pk__max { font-size: .85rem; opacity: .75; }
  .chips__l { font-size: .85rem; opacity: .75; align-self: center; }
  .chip.on { background: var(--green-mist); border-color: var(--green); }
  .hl { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 1.1rem; }
  .cmp-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; background: var(--white); border-radius: 16px; }
  .cmpt { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .cmpt th, .cmpt td { padding: 10px 12px; border-bottom: 1px solid var(--green-soft); text-align: left; vertical-align: top; }
  .cmpt thead th { background: var(--green); color: var(--white); font-weight: 700; white-space: nowrap; }
  .cmpt thead th.co { background: #1d4d42; }
  .cmpt tbody th { font-weight: 600; position: sticky; left: 0; background: var(--white); min-width: 120px; }
  .cmpt thead th:first-child { position: sticky; left: 0; z-index: 1; }
  .cmpt td { min-width: 110px; }
  .cmpt td.co { background: #f3f8f6; }
  .cmpt em { font-style: normal; font-weight: 700; display: block; }
  .cmpt small { display: block; font-size: .76rem; opacity: .75; }
  .cmpt tr.tot td, .cmpt tr.tot th { background: var(--green-mist); }
  .cmpt tr:last-child th, .cmpt tr:last-child td { border-bottom: 0; }
  .swipe { display: none; font-size: .82rem; opacity: .75; margin: -6px 0 0; }
  .notes { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .assume { font-size: .85rem; opacity: .8; }
  .out__small { font-size: .78rem; opacity: .75; }
  @media (max-width: 560px) { .grid3 { grid-template-columns: 1fr; } .card { padding: 18px 14px; } .swipe { display: block; } .cmpt { font-size: .88rem; } .cmpt th, .cmpt td { padding: 8px 8px; } .cmpt tbody th { min-width: 96px; } .cmpt td { min-width: 96px; } }
</style>
