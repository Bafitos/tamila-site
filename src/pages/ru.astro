---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import img from '../assets/tamila-aspen-portrait.jpg';
import { site } from '../data/site.js';

const faq = [
  ['Когда комиссия за продажу 1%?', 'Когда вы продаёте свой дом и покупаете следующий вместе с Тамилой. Если вы только продаёте, комиссия стандартная, до 3%.'],
  ['Нужно ли платить агенту покупателя?', 'Обычно да. Агент, который приводит покупателя на ваш дом, получает отдельную комиссию, обычно до 3%, и её можно обсуждать. 1% — это только сторона Тамилы.'],
  ['Почему Тамила может работать за 1%?', 'Когда вы покупаете следующий дом с ней, она получает комиссию агента покупателя, которую обычно платит продавец покупаемого дома. Поэтому на продаже она может взять меньше.'],
  ['Можно ли купить дом с плохой кредитной историей?', 'Часто да. Тамила работает с кредитным рейтингом примерно от 570. Если ниже, она покажет, как подготовиться. Начинается всё с мягкой проверки кредита (soft pull), которая не влияет на рейтинг.'],
  ['Я только приехал(а) в США. С чего начать?', 'С короткого разговора. Тамила сама приехала в 2001 году и объяснит, как устроена покупка дома и ипотека в Америке, на русском или украинском.'],
  ['Нужно ли делать ремонт перед продажей?', 'Обычно нет. У покупателя свой вкус, он всё равно всё переделает. Важнее правильная цена и готовность к инспекции покупателя.'],
];
---
<Base lang="ru" title="Русскоязычный риелтор и ипотека в Денвере | Тамила Аспен" description="Тамила Аспен — риелтор и ипотечный специалист в Денвере. Продажа дома за 1% при покупке следующего, ипотека с кредитным рейтингом от 570, VA-кредиты. Русский, украинский, английский." schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'ru', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}>
  <PageHero
    ru
    eyebrow="Риелтор и ипотечный специалист · Денвер, Колорадо"
    title="Покупка, продажа и ипотека в Денвере на русском и украинском"
    lead="Тамила Аспен родилась в Киеве и живёт в США с 2001 года. Магистр экономики, 23 года в финансах, 10 лет в недвижимости и ипотеке. Она объясняет каждый шаг понятным языком."
    image={img}
    imageAlt="Тамила Аспен, риелтор и ипотечный специалист в Денвере"
  />

  <section class="section mist">
    <div class="wrap">
      <h2 class="center">Чем Тамила может помочь</h2>
      <div class="cards">
        <article class="card"><h3>Продажа за 1%</h3><p>Когда вы продаёте дом и покупаете следующий с Тамилой. Полный сервис: профессиональные фото за её счёт, MLS, реклама, переговоры и сопровождение до закрытия.</p></article>
        <article class="card"><h3>Покупка дома</h3><p>Честный подбор районов под ваш бюджет, показы, сильные переговоры. Клиенты получали оплату closing costs продавцом и снижение цены.</p></article>
        <article class="card"><h3>Ипотека</h3><p>FHA, VA, USDA, Conventional, Jumbo, Non-QM и программы помощи с первым взносом. Кредитный рейтинг примерно от 570.</p></article>
        <article class="card"><h3>Военные и VA</h3><p>VA-кредиты без первоначального взноса, переезды по приказу (PCS). Сын Тамилы служит в U.S. Air Force.</p></article>
        <article class="card"><h3>Продажа при разводе</h3><p>Спокойно и нейтрально, вместе с адвокатами обеих сторон. Регалия RCS-D.</p></article>
        <article class="card"><h3>Проблемы с платежами</h3><p>Отстаёте по ипотеке? Чем раньше обратиться, тем больше вариантов. Регалия SFR.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Как устроена покупка дома в США</h2>
      <ol>
        <li><b>Предодобрение по ипотеке (pre-approval).</b> Узнаёте реальный бюджет. Часто за 24 часа.</li>
        <li><b>Подбор и показы.</b> Тамила честно говорит о плюсах и минусах каждого дома.</li>
        <li><b>Предложение (offer).</b> Цена и условия на основе реальных продаж рядом.</li>
        <li><b>Инспекция и оценка (appraisal).</b> Переговоры о ремонте по итогам инспекции.</li>
        <li><b>Закрытие сделки (closing).</b> Подписание документов и ключи.</li>
      </ol>
      <p class="callout">Тамила — и риелтор, и ипотечный специалист. Дом и кредит ведёт один человек, поэтому ничего не теряется между двумя офисами.</p>
    </div>
  </section>

  <Faq items={faq} title="Частые вопросы" />
  <ContactBand ru title="Бесплатная консультация на русском" lead="Оставьте заявку или позвоните. Тамила перезвонит, обычно в тот же день." goal="Продать и купить дом (1%)" />
</Base>
