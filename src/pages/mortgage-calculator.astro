---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site.js';

const faq = [
  ['Where does the interest rate in this calculator come from?', "It is this week's national average for a 30-year or 15-year fixed mortgage from the Freddie Mac Primary Mortgage Market Survey. It updates automatically every week. Your own rate depends on your credit, down payment, loan program and the day you lock, so ask Tamila for a real quote."],
  ['What is a metro district tax in Colorado?', 'Many newer Colorado neighborhoods were built with a metro district that paid for roads, water lines and parks. Homeowners repay it through extra mills on the property tax bill, often for decades. Two homes at the same price can have very different monthly payments because of it, so check the full tax bill for any home you consider.'],
  ['How much is FHA mortgage insurance?', 'FHA loans have an upfront premium of 1.75% of the loan, usually added to the loan, plus an annual premium paid monthly: 0.55% for most 30-year loans with less than 5% down, and 0.50% with 5% or more down (higher for loans above $726,200). With less than 10% down it lasts for the life of the loan.'],
  ['How much is the VA funding fee?', 'For a purchase with less than 5% down it is 2.15% of the loan on first use and 3.3% on later use. With 5% down it is 1.5%, and with 10% down it is 1.25%. Veterans who receive VA disability compensation, Purple Heart recipients and some surviving spouses are exempt. Your Certificate of Eligibility shows whether you are exempt.'],
  ['Does this include closing costs?', 'No. The cash figure covers only the down payment. Closing costs in Colorado are separate and can sometimes be paid by the seller. Tamila gives you a full estimate for a specific home.'],
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Colorado Mortgage Payment Calculator', url: `${site.url}/mortgage-calculator`, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, author: { '@id': `${site.url}/#tamila` }, description: 'Monthly payment calculator for Colorado homes with weekly national mortgage rates, FHA mortgage insurance, VA funding fee, property tax and metro district tax.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Colorado Mortgage Payment Calculator | Tamila Aspen" description="Free Colorado mortgage calculator with this week's rates, FHA and VA fees, property tax and metro district tax. See your real monthly payment." schema={schema}>
  <section class="section calc-hero">
    <div class="wrap narrow center stack">
      <p class="eyebrow">Free tool · Updated weekly</p>
      <h1>Colorado mortgage payment calculator</h1>
      <p class="lead">Your real monthly payment, not just principal and interest. Includes this week's average rate, FHA and VA fees, property tax, insurance, HOA and the Colorado metro district tax most calculators forget.</p>
    </div>
  </section>

  <section class="section calc-wrap">
    <div class="wrap calc">
      <form class="calc__form" id="calc" onsubmit="return false">
        <label>Home price
          <span class="money"><input id="price" type="number" inputmode="numeric" min="50000" step="1000" value="550000" /></span>
        </label>

        <label>Loan type
          <select id="type">
            <option value="conv">Conventional</option>
            <option value="fha">FHA</option>
            <option value="va1">VA, first use</option>
            <option value="va2">VA, used before</option>
            <option value="vax">VA, exempt from funding fee</option>
          </select>
        </label>

        <div class="row2">
          <label>Down payment
            <span class="pct"><input id="downPct" type="number" inputmode="decimal" min="0" max="90" step="0.5" value="10" /></span>
          </label>
          <label>Term
            <select id="term"><option value="30">30 years</option><option value="15">15 years</option></select>
          </label>
        </div>
        <p class="hint" id="downHint"></p>

        <label>Interest rate
          <span class="pct"><input id="rate" type="number" inputmode="decimal" min="1" max="15" step="0.01" value="7.40" /></span>
        </label>
        <p class="hint" id="rateHint">This week's national average (Freddie Mac). <button type="button" class="linkbtn" id="rateReset">Use this week's average</button></p>

        <details class="more" open>
          <summary>Taxes, insurance and HOA</summary>
          <div class="row2">
            <label>Property tax, % of price per year
              <span class="pct"><input id="tax" type="number" inputmode="decimal" min="0" max="3" step="0.01" value="0.55" /></span>
            </label>
            <label>Metro district tax, per year
              <span class="money"><input id="metro" type="number" inputmode="numeric" min="0" step="50" value="0" /></span>
            </label>
          </div>
          <p class="hint">Property tax is an estimate. Check the county assessor or the listing's tax bill. Metro district tax applies in many newer neighborhoods and is listed on the tax bill.</p>
          <div class="row2">
            <label>Home insurance, per year
              <span class="money"><input id="ins" type="number" inputmode="numeric" min="0" step="50" value="2400" /></span>
            </label>
            <label>HOA, per month
              <span class="money"><input id="hoa" type="number" inputmode="numeric" min="0" step="10" value="0" /></span>
            </label>
          </div>
          <label id="pmiRow">Private mortgage insurance (PMI), % per year
            <span class="pct"><input id="pmi" type="number" inputmode="decimal" min="0" max="2" step="0.05" value="0.5" /></span>
          </label>
          <p class="hint" id="pmiHint">Conventional loans with less than 20% down. The real rate depends on credit and down payment.</p>
        </details>
      </form>

      <div class="calc__out" aria-live="polite">
        <p class="out__label">Estimated monthly payment</p>
        <p class="out__total" id="total">$0</p>
        <div class="bar" id="bar"></div>
        <ul class="out__list" id="list"></ul>
        <dl class="out__facts">
          <div><dt>Loan amount</dt><dd id="loan">$0</dd></div>
          <div><dt>Down payment</dt><dd id="down">$0</dd></div>
        </dl>
        <p class="out__note" id="feeNote"></p>
        <div class="btns out__btns">
          <a class="pill" href="#contact">Get your real numbers from Tamila</a>
          <button type="button" class="pill pill--line" id="share">Copy link to this estimate</button>
        </div>
        <p class="out__small">Estimate only, not a loan offer or commitment to lend. Your rate and payment depend on credit, income, property and program guidelines. Loans through {site.lender}, NMLS #{site.lenderNmls}. Tamila Aspen, NMLS #{site.nmls}.</p>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap prose">
      <h2>Why two homes at the same price can cost different amounts each month</h2>
      <p><b>Metro district tax.</b> In many newer Colorado neighborhoods, an extra tax on the property tax bill repays the roads and utilities built for the subdivision. It can add hundreds of dollars a month. Older neighborhoods usually don't have it.</p>
      <p><b>HOA dues.</b> Condos and townhomes often include exterior maintenance, insurance for the building, water or trash. A higher HOA can still be the cheaper option overall.</p>
      <p><b>Loan program.</b> FHA adds an upfront fee and monthly mortgage insurance. VA has no monthly mortgage insurance but usually a one-time funding fee. Conventional loans need PMI only until you reach 20% equity.</p>
      <p>Tamila is both a real estate agent and a mortgage loan officer, so she calculates the full payment for every home you like before you make an offer.</p>
      <div class="btns"><a class="pill" href="/mortgage">Loan programs</a><a class="pill pill--line" href="/va-loans-pcs">VA loans &amp; PCS</a></div>
    </div>
  </section>

  <Faq items={faq} title="Calculator questions" />
  <ContactBand title="Want exact numbers for a real home?" lead="Send Tamila the address or your budget. She will calculate the full payment and check what you qualify for, usually the same day." goal="Get pre-approved for a loan" />
</Base>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
  let weekly = { rate30: 7.4, rate15: 6.73, date: '2026-10-08' };
  let rateTouched = false;

  // Read shared link values
  const qs = new URLSearchParams(location.search);
  for (const k of ['price', 'type', 'downPct', 'term', 'rate', 'tax', 'metro', 'ins', 'hoa', 'pmi']) {
    const v = qs.get(k);
    if (v !== null && $(k)) { $(k).value = v; if (k === 'rate') rateTouched = true; }
  }

  function vaFee(type: string, downPct: number) {
    if (type === 'vax') return 0;
    if (downPct >= 10) return 1.25;
    if (downPct >= 5) return 1.5;
    return type === 'va1' ? 2.15 : 3.3;
  }

  function calc() {
    const price = Math.max(0, +$('price').value || 0);
    const type = $('type').value;
    const downPct = Math.min(90, Math.max(0, +$('downPct').value || 0));
    const years = +$('term').value;
    const rate = Math.max(0, +$('rate').value || 0);
    const down = price * downPct / 100;
    let base = price - down;
    let feePct = 0, feeName = '', miYear = 0;
    const isVA = type.startsWith('va');
    const hint = $('downHint') as unknown as HTMLElement;
    hint.textContent = '';

    if (type === 'fha') {
      feePct = 1.75; feeName = 'FHA upfront mortgage insurance (1.75%)';
      const ltv = base / price;
      const big = base > 726200;
      miYear = big ? (ltv > 0.95 ? 0.75 : 0.70) : (ltv > 0.95 ? 0.55 : 0.50);
      if (downPct < 3.5) hint.textContent = 'FHA usually requires at least 3.5% down.';
    } else if (isVA) {
      feePct = vaFee(type, downPct);
      feeName = feePct ? `VA funding fee (${feePct}%)` : '';
    } else {
      if (downPct < 3) hint.textContent = 'Conventional loans usually require at least 3% down.';
      miYear = downPct < 20 ? (+$('pmi').value || 0) : 0;
    }
    const fee = base * feePct / 100;
    const loan = base + fee;
    const r = rate / 100 / 12, n = years * 12;
    const pi = r ? loan * r / (1 - Math.pow(1 + r, -n)) : loan / n;
    const mi = (type === 'fha' ? base : loan) * miYear / 100 / 12;
    const tax = price * (+$('tax').value || 0) / 100 / 12;
    const metro = (+$('metro').value || 0) / 12;
    const ins = (+$('ins').value || 0) / 12;
    const hoa = +$('hoa').value || 0;

    const parts = [
      ['Principal & interest', pi, '#255A4F'],
      ['Property tax', tax, '#4F8A7D'],
      ['Metro district tax', metro, '#8DB8AE'],
      ['Home insurance', ins, '#C1D5D2'],
      ['HOA', hoa, '#D9C7A3'],
      [type === 'fha' ? 'FHA mortgage insurance' : 'PMI', mi, '#B08D57'],
    ] as [string, number, string][];
    const total = parts.reduce((s, p) => s + p[1], 0);

    $('total').textContent = fmt(total);
    $('loan').textContent = fmt(loan);
    $('down').textContent = fmt(down);
    (document.getElementById('list')!).innerHTML = parts.filter((p) => p[1] > 0.5)
      .map((p) => `<li><span class="dot" style="background:${p[2]}"></span>${p[0]}<b>${fmt(p[1])}</b></li>`).join('');
    (document.getElementById('bar')!).innerHTML = parts.filter((p) => p[1] > 0.5)
      .map((p) => `<span style="width:${(p[1] / total * 100).toFixed(2)}%;background:${p[2]}" title="${p[0]}"></span>`).join('');
    (document.getElementById('feeNote')!).textContent = fee > 0
      ? `Includes ${feeName} of ${fmt(fee)}, added to the loan.` : (isVA ? 'No VA funding fee (exempt).' : '');
    (document.getElementById('pmiRow')!).style.display = type === 'conv' ? '' : 'none';
    (document.getElementById('pmiHint')!).style.display = type === 'conv' ? '' : 'none';
  }

  function applyWeekly() {
    const v = $('term').value === '15' ? weekly.rate15 : weekly.rate30;
    $('rate').value = v.toFixed(2);
    rateTouched = false;
    const d = new Date(weekly.date + 'T12:00:00');
    (document.getElementById('rateHint')!).firstChild!.textContent =
      `This week's national average for a ${$('term').value}-year fixed: ${v.toFixed(2)}% (Freddie Mac, ${d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}). `;
    calc();
  }

  fetch('/api/rates').then((r) => r.json()).then((d) => {
    if (d && d.rate30) weekly = d;
    if (!rateTouched) applyWeekly();
  }).catch(() => { if (!rateTouched) applyWeekly(); });

  document.getElementById('calc')!.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).id === 'rate') rateTouched = true;
    calc();
  });
  $('term').addEventListener('change', () => { if (!rateTouched) applyWeekly(); });
  $('type').addEventListener('change', () => {
    const t = $('type').value;
    if (t.startsWith('va') && +$('downPct').value === 10) $('downPct').value = '0';
    if (t === 'fha' && +$('downPct').value < 3.5) $('downPct').value = '3.5';
    calc();
  });
  document.getElementById('rateReset')!.addEventListener('click', applyWeekly);
  document.getElementById('share')!.addEventListener('click', async (e) => {
    const p = new URLSearchParams();
    for (const k of ['price', 'type', 'downPct', 'term', 'rate', 'tax', 'metro', 'ins', 'hoa', 'pmi']) p.set(k, $(k).value);
    const link = `${location.origin}${location.pathname}?${p}`;
    history.replaceState(null, '', link);
    try { await navigator.clipboard.writeText(link); (e.target as HTMLElement).textContent = 'Link copied'; }
    catch { (e.target as HTMLElement).textContent = 'Link is in the address bar'; }
  });
  calc();
</script>

<style>
  .calc-hero { padding-bottom: 8px; }
  .calc { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: start; }
  .calc > * { min-width: 0; }
  .calc__form { display: grid; gap: 16px; }
  .calc__form label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: .95rem; }
  .calc__form input, .calc__form select { font: 400 1.1rem var(--font); color: var(--ink); background: var(--white); border: 1.5px solid var(--green-soft); border-radius: 12px; padding: 12px 14px; width: 100%; }
  .calc__form input:focus, .calc__form select:focus { outline: 2px solid var(--green); outline-offset: 1px; }
  .money, .pct { position: relative; display: block; }
  .money input { padding-left: 28px; }
  .money::before { content: '$'; position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 400; opacity: .7; }
  .pct input { padding-right: 34px; }
  .pct::after { content: '%'; position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-weight: 400; opacity: .7; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .hint { font-size: .9rem; opacity: .85; margin-top: -8px; }
  .hint:empty { display: none; }
  .linkbtn { background: none; border: 0; padding: 0; color: var(--green); font: inherit; text-decoration: underline; cursor: pointer; }
  .more { border: 1px solid var(--green-soft); border-radius: 16px; padding: 6px 18px 18px; }
  .more summary { cursor: pointer; font-weight: 700; padding: 12px 0; }
  .more > *:not(summary) { margin-top: 14px; }
  .calc__out { position: sticky; top: 96px; background: var(--green-mist); border-radius: 24px; padding: 28px; display: grid; gap: 14px; }
  .out__label { font-weight: 700; }
  .out__total { font-size: clamp(2.4rem, 6vw, 3.4rem); font-weight: 300; color: var(--green); line-height: 1; }
  .bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; background: var(--green-soft); }
  .bar span { display: block; height: 100%; }
  .out__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .out__list li { display: flex; align-items: center; gap: 10px; font-weight: 400; }
  .out__list b { margin-left: auto; }
  .dot { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .out__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 4px 0 0; border-top: 1px solid var(--green-soft); padding-top: 14px; }
  .out__facts dt { font-size: .85rem; opacity: .8; }
  .out__facts dd { margin: 0; font-weight: 700; font-size: 1.15rem; }
  .out__note { font-size: .92rem; }
  .out__note:empty { display: none; }
  .out__btns { justify-content: flex-start; }
  .out__small { font-size: .78rem; opacity: .75; }
  @media (max-width: 900px) { .calc { grid-template-columns: 1fr; } .calc__out { position: static; } }
  @media (max-width: 480px) { .row2 { grid-template-columns: 1fr; } }
</style>
