---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Privacy Policy | Tamila Aspen" description="Privacy policy for denver-real-estates.com: what information Tamila Aspen collects through the contact form and how it is used.">
  <section class="section"><div class="wrap prose">
    <h1>Privacy Policy</h1>
    <p>This website is operated by Tamila Aspen. When you send a form, call, text or email, we collect the information you give us, such as your name, phone number, email and property details, and use it only to answer your request and to provide real estate or mortgage services.</p>
    <p>We do not sell your personal information. We share it only with parties needed to complete your transaction, such as lenders, title companies and other agents, or when the law requires it.</p>
    <p>If you give us your phone number, you agree that we may call or text you about your request. Message and data rates may apply. Reply STOP to opt out at any time.</p>
    <p>This website may use privacy-friendly analytics to understand which pages are useful. You can block cookies in your browser settings.</p>
    <p>Questions: {site.email} or {site.phone}.</p>
  </div></section>
</Base>
