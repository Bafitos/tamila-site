---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import ContactBand from '../components/ContactBand.astro';
import img from '../assets/tamila-aspen-loan-officer-laptop.jpg';
import { site } from '../data/site.js';
import { Image } from 'astro:assets';
import barrettLogo from '../assets/barrett-financial-logo.png';

const loans = [
  ['Conventional', 'For buyers with steady income and fair or good credit. Some programs start at a low down payment.'],
  ['FHA', 'Flexible credit rules and a low down payment. Popular with first-time buyers.'],
  ['VA', '0% down for eligible service members, veterans and some surviving spouses.'],
  ['USDA', '0% down in eligible rural and suburban areas.'],
  ['Jumbo', 'For higher-priced homes above standard loan limits.'],
  ['Non-QM', 'For self-employed buyers, investors and others whose income does not fit standard rules.'],
  ['Down payment assistance', 'Colorado programs that can help with the down payment or closing costs.'],
  ['Refinance', 'Lower your rate or payment, or take cash out, when it makes sense.'],
];
const faq = [
  ['What credit score do I need?', 'Tamila has programs for credit scores from 500, and even for borrowers with no credit score at all. Every situation is different: the program and the down payment depend on yours.'],
  ['I have no credit score, or I am self-employed or an investor. Is there a loan for me?', 'Very often, yes. There are programs with no credit score, programs that use bank statements instead of tax returns, and investor loans that qualify on the property rent instead of your income. Just ask: many more programs exist than most people know about.'],
  ['How fast can I get pre-approved?', 'Often within 24 hours once Tamila has your documents.'],
  ['Why use a loan officer who is also your real estate agent?', 'Your offer, your loan and your closing dates are managed by one person, so nothing falls between two offices. Sellers also trust an offer when the agent and the lender are the same person.'],
  ['Can you guarantee a rate?', 'No one honestly can before you apply. Rates depend on your credit, down payment, loan program, property and the market on the day you lock.'],
];
---
<Base title="Colorado Mortgage Loan Officer, Credit from 500 | Tamila Aspen" description="Colorado home loans with Tamila Aspen, NMLS #2490507: FHA, VA, conventional, jumbo, Non-QM and investor loans. Credit from 500 or no score." schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }]}>
  <PageHero
    eyebrow={`Mortgage · NMLS #${site.nmls}`}
    title="Home loans explained in plain words"
    lead="Tamila spent 23 years in finance and accounting before real estate. She looks at your whole picture and finds the loan that fits, not just the one that is easiest to sell."
    image={img}
    imageAlt="Tamila Aspen working on a laptop in a hotel lounge"
    pos="50% 30%"
    cta2={[site.applyUrl, 'Apply online']}
  />

  <section class="section mist">
    <div class="wrap">
      <h2 class="center">Loan programs</h2>
      <div class="cards">
        {loans.map(([h, p]) => <article class="card"><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Can I buy a home with bad credit?</h2>
      <p>Often, yes. Tamila has programs for credit scores from <b>500</b>, and even for borrowers with no credit score at all. The lower the score, the more the program and down payment matter, so she compares the options side by side for you.</p>
      <p class="callout"><b>Every situation is different.</b> Self-employed, investor, no credit score, recent credit problems: just ask. Many more programs exist than most people know about. It starts with a soft credit check that does not affect your score.</p>
      <h2>Your real monthly payment</h2>
      <p>The price of a home is only part of the story. Your payment also includes property taxes, insurance, HOA fees and, on some loans, mortgage insurance. Tamila calculates the full payment for each home you are considering, so there are no surprises.</p>
      <p><a class="pill" href="/mortgage-calculator">Try the Colorado payment calculator</a></p>
      <a href={site.profiles.barrett} target="_blank" rel="noopener" class="lender-logo"><Image src={barrettLogo} alt="Barrett Financial Group" widths={[240, 480]} sizes="220px" /></a>
      <p class="small">{site.lenderDisclaimer} <a href={`https://www.nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/${site.lenderNmls}`} target="_blank" rel="noopener">nmlsconsumeraccess.org/EntityDetails.aspx/COMPANY/{site.lenderNmls}</a></p>
    </div>
  </section>

  <Faq items={faq} title="Mortgage questions" />
  <ContactBand title="Find out what you qualify for" lead="A short call and a soft credit check, which doesn't affect your score. Tamila will explain your options the same day." goal="Get pre-approved for a loan" />
</Base>
<style>
  .lender-logo { display: block; width: 220px; margin-top: 24px; }
  .lender-logo img { width: 100%; height: auto; }.small { font-size: .85rem; opacity: .8; }</style>
