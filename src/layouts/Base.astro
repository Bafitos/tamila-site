---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import ogImage from '../assets/tamila-aspen-on-phone.jpg';
import { getImage } from 'astro:assets';

const { title, description, schema = [], lang = 'en' } = Astro.props;
const bar = { en: ['Call Tamila', 'Text'], ru: ['Позвонить', 'Написать'], uk: ['Зателефонувати', 'Написати'] }[lang] ?? ['Call Tamila', 'Text'];
// build.format 'file' gives paths like /areas/aurora.html; the live site serves clean URLs.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/^$/, '/');
const canonical = new URL(cleanPath, site.url).href;
const og = await getImage({ src: ogImage, width: 1200, format: 'jpg' });
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(og.src, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#255A4F" />
  <meta name="google-site-verification" content="M8tiM92iHp7c87nOwIsc2ltwpgID_hEH9-0wUhgjoOw" />
  <meta name="msvalidate.01" content="3A625114A96E7F251C21E066A0FDC7ED" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,300;6..12,400;6..12,700;6..12,800&display=swap" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <a class="to-top" href="#main" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 15l7-7 7 7" /></svg>
  </a>
  <nav class="callbar" aria-label="Quick contact">
    <a class="pill" href={`tel:${site.phoneHref}`}>{bar[0]}</a>
    <a class="pill pill--line" href={`sms:${site.phoneHref}`}>{bar[1]}</a>
  </nav>
</body>
</html>

<style is:global>
  /* Design follows the current Wix site: deep green on white, light humanist sans, centered headings,
     green review cards, sage contact band, charcoal footer. */
  :root {
    --green: #255A4F;
    --green-2: #2F6E61;
    --green-soft: #D0DEDC;
    --green-mist: #F2F7F6;
    --sage: #C1D5D2;
    --charcoal: #222524;
    --ink: #1B2421;
    --white: #FFFFFF;
    --font: 'Nunito Sans', 'Avenir Next', Avenir, 'Segoe UI', system-ui, sans-serif;
    --wrap: 1120px;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--white); color: var(--green); font: 300 18px/1.65 var(--font); }
  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; }
  h1, h2, h3 { margin: 0; font-weight: 300; line-height: 1.15; text-wrap: balance; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.1rem, 5.6vw, 3.6rem); color: var(--ink); }
  h2 { font-size: clamp(1.8rem, 4vw, 2.7rem); }
  h3 { font-size: 1.3rem; font-weight: 700; }
  p { margin: 0; }
  strong, b { font-weight: 700; }
  :focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 20; background: var(--white); padding: 8px 12px; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding-inline: 20px; }
  .narrow { max-width: 760px; margin-inline: auto; }
  .center { text-align: center; }
  .section { padding-block: 80px; }
  .rule { border: 0; border-top: 1px solid var(--green); max-width: var(--wrap); margin: 0 auto; opacity: .5; }
  .eyebrow { font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .lead { font-size: 1.2rem; }
  .stack { display: flex; flex-direction: column; gap: 18px; }
  .pill { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 12px 28px; border-radius: 999px; background: var(--green); color: var(--white); font: 700 1rem/1.2 var(--font); text-decoration: none; border: 2px solid var(--green); cursor: pointer; transition: background .2s; }
  .pill:hover { background: var(--green-2); }
  .pill--line { background: transparent; color: var(--green); }
  .pill--line:hover { background: var(--green-mist); }
  .pill--dark { background: #111; border-color: #111; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .to-top { position: fixed; right: 16px; bottom: calc(88px + env(safe-area-inset-bottom, 0px)); width: 52px; height: 52px; border-radius: 50%; background: var(--white); border: 2px solid var(--green); display: grid; place-items: center; z-index: 8; }
  .to-top svg { width: 24px; height: 24px; fill: none; stroke: var(--green); stroke-width: 2; }
  .callbar { display: none; }
  @media (max-width: 760px) {
    body { font-size: 17px; padding-bottom: 76px; }
    .section { padding-block: 60px; }
    .callbar { display: flex; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 9; padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); background: var(--white); border-top: 1px solid var(--green-soft); }
    .callbar .pill { flex: 1; min-height: 48px; padding: 10px; }
  }
  @media (min-width: 761px) { .to-top { bottom: 24px; } }

  /* shared blocks */
  .mist { background: var(--green-mist); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  .card { border: 1px solid var(--green-soft); border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 10px; min-width: 0; background: var(--white); text-decoration: none; }
  a.card:hover { border-color: var(--green); }
  .card p { font-weight: 400; font-size: 1rem; }
  .card .more { margin-top: auto; font-weight: 700; }
  .tag { align-self: flex-start; font-size: .75rem; font-weight: 800; letter-spacing: .08em; background: var(--green-mist); padding: 4px 10px; border-radius: 999px; }
  .gcard { margin: 0; background: var(--green); color: var(--white); border-radius: 24px; padding: 30px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .gcard h3 { font-size: 1.35rem; }
  .gcard__where { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700; opacity: .8; }
  .gcard blockquote { margin: 0; font-weight: 300; }
  .gcard figcaption { margin-top: auto; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .gcard--sm blockquote { font-size: 1rem; }
  .prose { max-width: 720px; margin-inline: auto; }
  .prose > * + * { margin-top: 18px; }
  .prose p, .prose li { font-weight: 400; }
  .prose h2 { margin-top: 48px; }
  .prose h3 { margin-top: 32px; }
  .prose ul, .prose ol { padding-left: 1.3em; display: grid; gap: 8px; }
  .checks { list-style: none; padding: 0 !important; }
  .checks li { position: relative; padding-left: 30px; }
  .checks li::before { content: ''; position: absolute; left: 4px; top: .5em; width: 12px; height: 7px; border-left: 2.5px solid var(--green); border-bottom: 2.5px solid var(--green); transform: rotate(-45deg); }
  .callout { background: var(--green-mist); border-left: 4px solid var(--green); border-radius: 0 16px 16px 0; padding: 20px 24px; font-weight: 400; }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .cards { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
</style>
