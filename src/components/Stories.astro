---
const { items, title = 'In the clients’ own words', lead = '' } = Astro.props;
---
<section class="section mist">
  <div class="wrap">
    <div class="narrow center stack">
      <h2>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class={`st ${items.length === 1 ? 'st--one' : ''}`}>
      {items.map((s) => (
        <figure class="gcard">
          {s.where && <p class="gcard__where">{s.where}</p>}
          {s.title && <h3>{s.title}</h3>}
          <blockquote>“{s.text}”</blockquote>
          <figcaption>{s.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .st { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
  .st--one { grid-template-columns: 1fr; max-width: 760px; margin-inline: auto; }
  @media (max-width: 700px) { .st { grid-template-columns: 1fr; } }
</style>
